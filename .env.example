# Safe-off by default. Never place real credentials or production IDs here.
VITE_FIREBASE_DUAL_WRITE_ENABLED=false
VITE_FIREBASE_DUAL_WRITE_UID_ALLOWLIST=
VITE_FIREBASE_DUAL_WRITE_ORG_ALLOWLIST=

# Browser-safe AI Gateway configuration. Provider API keys must stay on the server.
VITE_AI_ENABLED=false
VITE_AI_PROVIDER=openai
VITE_AI_GATEWAY_URL=

# App Store review builds keep the unverified iOS native camera preview and
# motion sensor path disabled. Enable only after iPhone/iPad device validation.
VITE_IOS_NATIVE_CAPTURE_ENABLED=false
