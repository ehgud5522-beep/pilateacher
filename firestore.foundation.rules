rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membershipId(organizationId) {
      return organizationId + "_" + request.auth.uid;
    }

    function membership(organizationId) {
      return get(/databases/$(database)/documents/memberships/$(membershipId(organizationId)));
    }

    function isActiveMember(organizationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/memberships/$(membershipId(organizationId)))
        && membership(organizationId).data.status == "active";
    }

    function hasRole(organizationId, roles) {
      return isActiveMember(organizationId)
        && membership(organizationId).data.role in roles;
    }

    /* ── 대표와 같은 자리 ─────────────────────────────────────────────────
       총괄매니저(area_manager)는 **지점 경계 없이 대표와 같은 권한**이다.
       2026-10-10 결정. 지점으로 가르는 설계는 보류했다 (branch-manager-plan.md).

       그래서 규칙에서 `["owner"]` 였던 자리는 거의 전부 이 목록이 된다.
       대표만 남는 것은 넷뿐이고, 공통점 하나로 묶인다 -- **자기 자리를 자기가
       넓히는 길**이거나 되돌릴 수 없다:

         1. 총괄매니저 지정·해제   (memberships 의 role 문)
         2. 대표 계정 수정         (아래 mayManageMembership)
         3. 누구를 대표로 지정     (memberships create 의 role 목록)
         4. 이관 초기화            (resetMigratedData -- callable 쪽)

       총괄매니저가 총괄매니저를 세울 수 있으면 대표가 모르는 사이에 그 자리가
       늘고, 그것을 되돌리는 문은 없다.

       Keep in sync with OWNER_LEVEL_ROLES in functions/shared/constants.mjs. */
    function ownerLevel() {
      return ["owner", "area_manager"];
    }

    /* 이 소속 문서를 건드려도 되는가.

       대표는 전부. 총괄매니저는 **자기보다 아래만** -- 대표와 다른 총괄매니저의
       소속은 건드리지 못한다 (위 1·2번).

       역할 판정을 한 번만 부른다. 같은 문서를 여러 번 읽는 것이 요청당 접근
       수를 올리지는 않지만(같은 경로는 한 번으로 센다), 조건이 길어질수록
       어느 갈래가 통과했는지 읽기 어려워진다. */
    function mayManageMembership(organizationId, target) {
      return isActiveMember(organizationId)
        && (
          membership(organizationId).data.role == "owner"
          || (
            membership(organizationId).data.role == "area_manager"
            && !(target.role in ownerLevel())
          )
        );
    }

    /* ── 센터 데이터를 읽는 사람들 ────────────────────────────────────────
       isActiveMember 는 소속만 보고 역할을 보지 않는다. 그래서 role "member"
       라도 소속 문서 하나만 있으면 센터의 회원권·원장·상품을 전부 읽었다 --
       baseUnitPrice · netContractPrice · unitPrice · rule 까지.

       회원용 조회 앱(docs/member-app-design.md)은 "회원에게 memberships 를
       만들지 않는다" 로 그것을 피하고 있었는데, 그것은 규칙이 아니라 약속이다.
       약속은 다음 사람이 모르고, 손으로 소속 문서 하나를 만드는 순간 깨진다.

       그래서 규칙으로 옮긴다. 네 역할을 그대로 나열하므로 지금 쓰는 사람의
       읽기는 하나도 바뀌지 않는다 -- 달라지는 것은 member(와 앞으로 생길 목록
       밖 역할)뿐이다.

       회원이 읽는 곳은 셋뿐이다: memberViews · memberLinks · 자기 clients 문서. */
    function isCentreStaff(organizationId) {
      return hasRole(organizationId, ["owner", "area_manager", "manager", "instructor", "staff"]);
    }

    // ── 돈이 걸린 두 문 ───────────────────────────────────────────────────
    // 회원권 발급과 회원 등록. 발급은 그 순간 급여의 근거를 만들고, 등록은 그
    // 발급이 가리킬 사람을 만든다 — 둘 다 원장에 append-only 로 남아 나중에
    // 고칠 수 없다.
    //
    // 2026-09-23: FC매니저(role manager)에게 다시 열었다. 상담·계약을 FC 가
    // 받고, 대표가 센터에 없는 동안 발급이 밀렸다. 회원권 상품 추가·종료도 같은
    // 날 함께 열었다 (products 블록). 취소·보정·급여·감사 로그·강사 관리는
    // 여전히 대표만이다. 다시 좁힐 때는 아래 두 목록과 canManageProducts 에서
    // "manager" 를 빼면 된다.
    function canIssuePass(organizationId) {
      return hasRole(organizationId, ["owner", "area_manager", "manager"]);
    }

    function canRegisterClient(organizationId) {
      return hasRole(organizationId, ["owner", "area_manager", "manager"]);
    }

    function canManageProducts(organizationId) {
      return hasRole(organizationId, ["owner", "area_manager", "manager"]);
    }

    // Keep in sync with PAY_CATEGORY in src/data/schema/constants.js. Rules
    // files cannot import, so products and the pass ledger share this instead.
    /* ── 급여 카테고리 ────────────────────────────────────────────────────
       **원장 항목의 category 가 이 목록을 지난다** (아래 ledger create). 그래서
       여기 없는 카테고리는 상품을 못 만드는 것으로 끝나지 않고, **그 회원권의
       모든 차감이 거부된다.**

       2026-10-10: 셋이 빠져 있었다 -- pt_2_1_repurchase_event (2026-10-09 신설),
       diosa_a, diosa_b (2026-10-05 신설). 앱은 그 카테고리로 차감을 보내고
       규칙이 그것을 받지 않았다. 화면에는 permission-denied 한 줄로 도착한다.

       앱의 PAY_CATEGORY 를 늘릴 때 이 목록을 함께 늘리지 않으면 같은 일이
       다시 난다. 규칙은 import 을 할 수 없어 리터럴로 적는 수밖에 없고, 그래서
       tests/rules 가 두 목록이 같은지 본다.
       Keep in sync with PAY_CATEGORY in functions/shared/constants.mjs. */
    /* ── 원장에 쓸 수 있는 최소 앱 빌드 ────────────────────────────────────
       **0 이면 꺼져 있다.** 지금이 그 상태다.

       왜 필요한가: 차감 단가도 누적 증가도 전부 기기에서 돈다. 규칙은 금액이
       맞는지 따질 수 없다 -- 20회 판정이 다른 컬렉션에 있고 부원장 5:5 는
       계약 금액을 나눠야 한다. 그래서 **업데이트하지 않은 폰은 옛 규칙으로
       계산한 차감을 그대로 원장에 박는다.** 원장은 append-only 다.

       2026-10-01 에 한 번 겪었다 (settlement-gate.js 머리말): 같은 듀엣
       수업을 새 빌드는 2:1 에서, 옛 빌드는 1:1 에서 뺐다. 2026-10-16 에
       또 겪었다 -- 2:1 재등록이 20회 미만에서 25,000 으로 찍혔다.

       settlement-gate 는 **화면을 막는 자리**이고 옛 빌드는 그 코드를 아예
       갖고 있지 않다. 진짜로 막는 것은 여기다.

       ── 켜기 전에 ──
       **강사 전원이 그 번호 이상이어야 한다.** 낮은 앱은 수업 확정이
       permission-denied 로 막히고, 화면에는 그 한 줄만 도착한다. 대표 화면이
       "강사 N명 모두 ○○ 이상" 을 말해 준다 (app-version-report.js).

       ── 모르는 빌드는 막는다 ──
       빌드 62 부터 앱이 열릴 때 스스로 적는다. 그보다 낮은 앱은 이 칸이 아예
       없고, 그것이 곧 "아주 낡은 앱" 이다. 열어 두면 막으려던 바로 그 앱이
       지나간다.

       숫자로 비교한다. 문자열로 두면 "9" > "10" 이다. */
    function minimumLedgerBuild() {
      return 0;
    }

    function appBuildAllowed(organizationId) {
      return minimumLedgerBuild() <= 0 || (
        ("appBuild" in membership(organizationId).data)
        && membership(organizationId).data.appBuild.matches("^[0-9]+$")
        && int(membership(organizationId).data.appBuild) >= minimumLedgerBuild()
      );
    }

    /* 갓 발급하고 한 회차도 안 쓴 회원권인가. **FC매니저의 취소 창이다**
       (2026-10-26 대표 결정).

       ── 안 쓴 것을 어떻게 아는가 ──
       **잔여가 총회차(서비스 포함)와 같은가**로 본다. 차감 건수를 셀 수 없다 --
       규칙은 하위 컬렉션(원장)을 훑지 못하고, 회원권 문서는 자기 차감 수를
       들고 있지 않다.

       ── 창은 24시간 ──
       "같은 날" 을 한국 날짜로 판정할 수 없다. 규칙의 시각은 UTC 라, KST 아침에
       취소하면 UTC 로는 어제가 되어 거부된다. 24시간으로 두면 시간대를
       건드리지 않고 같은 것을 뜻한다.

       **pass-repository.js 의 isFreshlyIssuedPass 와 같은 조건이다.** 한쪽만
       고치면 화면은 되는데 규칙이 막고, 쓰는 사람에게는 "눌렀는데 아무 일도
       안 일어남" 으로 도착한다. */
    function freshlyIssuedPass(pass) {
      return pass.remainingCount is int
        && pass.totalSessions is int
        && pass.remainingCount == pass.totalSessions + (("serviceSessions" in pass) ? pass.serviceSessions : 0)
        /* 발급 시각을 못 읽으면 창 밖이다. 모를 때 열어 두면 그 칸이 없던
           시절의 옛 회원권이 전부 통과한다. */
        && "createdAt" in pass
        && pass.createdAt is timestamp
        && request.time < pass.createdAt + duration.value(24, "h");
    }

    function payCategories() {
      return [
        "pt_1_1_new", "pt_1_1_repurchase_event", "pt_1_1_repurchase_normal",
        "pt_2_1_new", "pt_2_1_repurchase", "pt_2_1_repurchase_event",
        "diosa_a", "diosa_b",
        "service", "letmein", "etc"
      ];
    }

    // Keep in sync with CLIENT_STATUS in src/data/schema/constants.js. The
    // registration screen only ever produces the first three
    // (CLIENT_STATUS_FOR_CREATE); deleted and inactive exist because migrated
    // data carries them, so the rule has to keep accepting them.
    function clientStatuses() {
      return ["active", "hold", "ended", "deleted", "inactive"];
    }

    // Each clause passes when the field is absent. See the clients block for
    // why this is a floor and not a fixed set.
    function clientFieldsWellFormed() {
      return (!("name" in request.resource.data)
          || (request.resource.data.name is string && request.resource.data.name.size() > 0))
        // Stored digits-only, so one number has one spelling. A number split
        // across 010-1234-5678 and 01012345678 quietly breaks both the search
        // and the same-name check the registration screen shows.
        && (!("phone" in request.resource.data)
          || request.resource.data.phone is string)
        // The adapter writes null when a legacy member has no location yet.
        && (!("locationId" in request.resource.data)
          || request.resource.data.locationId == null
          || request.resource.data.locationId is string)
        && (!("status" in request.resource.data)
          || request.resource.data.status in clientStatuses())
        // A client-made timestamp is refused even when it is accurate — it is
        // the one field a caller could use to backdate a record.
        && (!("createdAt" in request.resource.data)
          || request.resource.data.createdAt == request.time)
        // Nobody files a registration under someone else's name.
        && (!("createdBy" in request.resource.data)
          || request.resource.data.createdBy == request.auth.uid);
    }

    // ── list is evaluated against the query, not the results ──────────────
    // A `resource.data` test inside a read rule cannot be satisfied by a
    // collection query unless the query itself constrains that same field.
    // Firestore does not return "false" in that case — it raises "Property X is
    // undefined on object" and refuses the whole query, which reaches a screen
    // as an empty list. An empty collection passes quietly, so the defect stays
    // invisible until the first document exists.
    //
    // Two shapes, two fixes:
    //
    //   A. Documents under /organizations/{organizationId}/…
    //      The path already pins the organization, so the field test is
    //      redundant for a list. get keeps it; list drops it.
    //      Done: clients, locations, lessons, lessons/participants, lessonNotes.
    //
    //   B. Top-level documents that carry organizationId in the body.
    //      The rule is correct as written and needs no change — but the caller
    //      MUST query with where("organizationId", "==", …) so the rule has
    //      something to evaluate. memberships already works this way.
    //      Nothing to fix here; the requirement lives in the repository.
    //
    // Still carrying the class-B requirement, with no list caller yet. Whoever
    // writes the first one must filter on organizationId (and, where the rule
    // also allows "my own document", accept that a list is role-only):
    //   assessments, assessmentMedia, inbodyMeasurements, exercisePrograms,
    //   exerciseHistory, aiRecommendations, aiFeedback, outcomes, memberGoals,
    //   memberProgress, events, dailyStats, teacherPatterns.
    //
    // auditLogs was on that list and is the first one with a real caller. It
    // stays class B — the audit screen queries it with
    // where("organizationId", "==", …) and a list without that filter is
    // refused, which the rules tests now pin.
    //
    // Already list-safe, no resource.data in their read rule: organizations,
    // products, passes, passes/ledger, runtimeConfig, and everything under
    // /users/{userId}.

    function sameOrganization() {
      return request.resource.data.organizationId == resource.data.organizationId;
    }

    function immutable(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    /* 연락처의 숫자만. 하이픈·공백이 섞여도 같은 번호는 같은 값이 된다.
       저장은 숫자만이지만(functions/shared/phone.mjs), 기기마다 명부가 따로라
       철자가 다른 값이 올라온다 -- 철자 때문에 수정이 거부되면 안 된다. */
    function phoneDigits(data) {
      return ("phone" in data) && (data.phone is string)
        ? data.phone.replace("[^0-9]", "")
        : "";
    }

    /* 번호가 **실제로** 바뀌는가. 값 비교(immutable)가 아니라 숫자 비교다.

       값으로 막으면 옛 철자를 든 기기가 회원 메모를 고칠 때 그 수정이 통째로
       거부되고, 코디네이터가 그 실패를 조용히 삼킨다 -- 강사에게는 저장된
       것으로 보인다. 숫자로 막으면 진짜 변경만 걸리고 철자 재전송은 통과한다.

       바꾸는 길은 여전히 하나다: updateClientPhone callable (Admin SDK 는
       규칙을 지나지 않는다). */
    function phoneUnchanged() {
      return phoneDigits(request.resource.data) == phoneDigits(resource.data);
    }

    function isOwnClientDocument(data) {
      return signedIn() && data.userId == request.auth.uid;
    }

    // 소속 문서의 표시용 두 칸. 있으면 형태를 따지고, 없어도 된다 — 이 필드들이
    // 생기기 전에 만들어진 소속에는 둘 다 없다.
    //
    // title 은 센터에서 부르는 이름이지 권한이 아니다. 부원장은 여기 없다:
    // 그것은 급여 판정 1 그 자체라 isDeputyDirector 하나로만 두고, 같은 사실을
    // 두 곳에 적어 어긋나게 두지 않는다.
    // Keep in sync with MEMBERSHIP_TITLE in src/data/schema/constants.js.
    /* 공지 본문. 있으면 모양을 따지고, 없어도 되는 칸은 없어도 된다.

       링크는 http(s) 만 받는다 -- javascript: 같은 것이 들어오면 누르는 사람의
       앱 안에서 돈다. 쓰는 사람이 대표라도 그 문을 열어 둘 이유가 없다.
       Keep in sync with noticeError in functions/shared/notices.mjs. */
    function noticeBodyWellFormed() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.status in ["active", "ended"]
        && (!("important" in request.resource.data) || request.resource.data.important is bool)
        && (!("linkUrl" in request.resource.data)
          || request.resource.data.linkUrl.matches("^https?://.*"))
        && (!("imageUrl" in request.resource.data)
          || request.resource.data.imageUrl.matches("^https?://.*"))
        && (!("locationIds" in request.resource.data) || request.resource.data.locationIds is list)
        && (!("titles" in request.resource.data) || request.resource.data.titles is list)
        && (!("roles" in request.resource.data) || request.resource.data.roles is list)
        && (!("startsOn" in request.resource.data)
          || request.resource.data.startsOn.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$"))
        && (!("endsOn" in request.resource.data)
          || request.resource.data.endsOn.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$"));
    }

    function membershipProfileWellFormed() {
      return (!("title" in request.resource.data)
          || request.resource.data.title in ["instructor", "team_lead", "branch_manager"])
        && (!("locationId" in request.resource.data)
          || (request.resource.data.locationId is string
            && request.resource.data.locationId.size() > 0))
        /* 맡은 지점들. **목록인지까지만 본다** -- 어느 지점이 실재하는지는
           규칙이 알 수 없고(locations 를 훑어야 한다), 그것은 화면이 고르게
           해서 지킨다. 빈 목록도 받는다: FC매니저에게 0개를 막는 것은 화면의
           일이고, 여기서 막으면 지점을 지우는 길이 영영 없어진다.

           **누가 쓸 수 있는가는 바뀌지 않는다** -- 이 칸도 위의
           mayManageMembership 문으로만 들어온다 (대표·총괄매니저). FC매니저는
           자기 지점을 볼 수만 있고 바꾸지 못한다. */
        && (!("locationIds" in request.resource.data)
          || request.resource.data.locationIds is list);
    }

    /* ── 센터에서 부르는 이름을 누가 정했는가 ──────────────────────────────
       강사 앱은 열릴 때마다 로그인 계정의 이름을 자기 소속 문서에 적는다
       (syncOwnMembershipName). 그래서 대표가 강사 관리에서 고친 이름이 그
       강사가 앱을 **한 번 여는 순간** 구글 계정 이름으로 되돌아갔고, 급여
       집계도 그 이름으로 섰다 -- 2026-10-10 에 "e asy" 로 보고된 것이 이것이다.

       앱만 고치면 모자란다. 업데이트하지 않은 기기가 계속 되돌리기 때문에,
       **문을 여기서 닫는다.** 대표가 정한 이름이면 본인도 덮지 못한다.

       본인 문이 하는 일은 하나뿐이었다(로그인 이름 채우기)라, 그것을 막는
       것이 곧 그 동기화를 막는 것이다 -- 사람이 손으로 자기 이름을 고치는
       화면은 이 앱에 없다.

       Keep in sync with DISPLAY_NAME_BY in functions/shared/constants.mjs. */
    function nameSetByOwner(data) {
      return ("displayNameBy" in data) && data.displayNameBy == "owner";
    }

    match /users/{userId} {
      allow create, read: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn()
        && request.auth.uid == userId
        && immutable(["role", "plan", "subscriptionStatus", "aiUsageCount"]);
      allow delete: if false;

      // Legacy compatibility: preserves the current user's own backup access.
      match /backup/{backupId} {
        allow read, create, update: if signedIn() && request.auth.uid == userId;
        allow delete: if false;
      }

      match /aiConsents/{memberId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && memberId.size() > 0
          && memberId.size() <= 160
          && request.resource.data.keys().hasOnly([
            "status", "policyVersion", "scopes", "grantedAt", "revokedAt", "updatedAt"
          ])
          && request.resource.data.status in ["granted", "revoked"]
          && request.resource.data.policyVersion == "2026-08-23"
          && request.resource.data.scopes is list
          && request.resource.data.scopes.size() <= 4
          && request.resource.data.scopes.hasOnly([
            "analyzeBody", "summarizeVoice", "recommendSequence", "generateReport"
          ])
          && request.resource.data.updatedAt is timestamp
          && (
            request.resource.data.status == "granted"
              ? request.resource.data.grantedAt is timestamp && request.resource.data.revokedAt == null
              : request.resource.data.revokedAt is timestamp && request.resource.data.scopes.size() == 0
          );
        allow delete: if false;
      }

      match /photoBackups/{photoId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && photoId.size() > 0
          && photoId.size() <= 160
          && request.resource.data.photoId == photoId
          && request.resource.data.memberId is string
          && request.resource.data.memberId.size() <= 160
          && request.resource.data.status in ["active", "deleted"]
          && request.resource.data.storagePath == "users/" + userId + "/photos/" + photoId + "/image.jpg"
          && request.resource.data.thumbnailPath == "users/" + userId + "/photos/" + photoId + "/thumb.jpg"
          && request.resource.data.imageBytes is int
          && request.resource.data.thumbnailBytes is int
          && request.resource.data.references is list
          && request.resource.data.references.size() <= 20;
        // Physical deletion is server-owned after the 30-day retention period.
        allow delete: if false;
      }

      /* ── 본인 전용 일정 (2026-10-31, 동기화 3단계) ──────────────────────────────
         개인 일정(상담 · 휴무 -- 이름 · 날짜 · 시각만)과 그룹 수업(인원만) 두 종류.
         **그 계정 본인만 읽고 쓴다** -- 대표 · FC · 다른 강사 · 회원은 읽지도 쓰지도 못한다.
         센터 직원이 읽는 lessons 에는 싣지 않는다.

         메모 · 수업 메모 · 상담 메모 · 회원 목표는 싣지 않는다 (대표 결정) -- 입력한 기기에만
         남는다. 그 칸(memo · body · goal · focus 따위)이나 다른 종류가 든 쓰기는 칸 목록에서
         막힌다. 칸 목록을 닫아 둔다 -- 다른 것을 싣는 길을 만들지 않는다.

         1 · 2단계와 같은 틀: 만들 때 revision 1, 고칠 때 +1 (앱이 서버 번호와 견주어
         다른 기기의 수정을 덮지 않는다). 지우지 않고 deletedAt 으로 표시한다.

         한계: 본인 전용이라 퇴사 · 담당 변경 때 센터가 넘겨받을 수 없다 (5단계에서 정한다). */
      function privateItemWellFormed(itemId) {
        let data = request.resource.data;
        return data.keys().hasOnly([
            "itemId", "kind", "date", "start", "end", "title", "type", "room",
            "equipmentIds", "groupCount", "actualCount", "noshowCount", "groupDone", "groupCancelled",
            "revision", "updatedAt", "createdAt", "updatedDevice", "deletedAt"
          ])
          && data.get("itemId", "") == itemId
          && data.get("kind", "") in ["personal", "group"]
          && data.get("title", "").size() <= 200;
      }
      match /scheduleItems/{itemId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId
          && privateItemWellFormed(itemId)
          && request.resource.data.get("revision", 0) == 1;
        allow update: if signedIn() && request.auth.uid == userId
          && privateItemWellFormed(itemId)
          && request.resource.data.get("revision", 0) == resource.data.get("revision", 0) + 1;
        allow delete: if false;
      }
    }

    /* 본인 일정 · 메모 동기화 스위치 (2026-10-31). 센터 수업 스위치와 따로 켜고 끈다.
       쓰기는 대표 전용 통로(updateRuntimeConfig)뿐이다. */
    match /runtimeConfig/privateSync {
      allow read: if signedIn();
      allow write: if false;
    }

    match /runtimeConfig/aiRecording {
      allow read: if signedIn();
      allow write: if false;
    }

    /* ── 앱이 읽어야 하는 운영 설정 둘 ──────────────────────────────────────
       둘 다 콘솔이나 대표 전용 통로로만 쓰고, 앱은 읽기만 한다. 쓰기를 열지
       않는 이유는 aiRecording 과 같다 -- 이 숫자 하나가 센터 전체의 확정을
       막을 수 있어, 실수로 눌러지는 자리를 만들지 않는다.

       **읽기는 signedIn() 이다.** 대표는 "센터 소속만" 을 원했는데 그것이
       여기서는 표현되지 않는다: 문서 경로에 조직이 없어 어느 소속을 봐야
       하는지 규칙이 알 수 없고, 규칙에는 "아무 소속이나 하나라도 있는가" 를
       묻는 길이 없다. 담긴 것은 빌드 번호와 안내 문구뿐이라 로그인한 사람에게
       열어도 새는 것이 없다. aiRecording 이 같은 판단으로 같은 자리에 있다.

       settlement 는 지금까지 match 가 아예 없어 **읽기가 막혀 있었다.** 그래서
       settlement-gate 가 설정을 못 읽고 언제나 열린 채로 돌았다 -- 최소 빌드를
       올려도 아무도 막히지 않았다. 그 장치를 실제로 켜는 것이 이 줄이다. */
    match /runtimeConfig/appUpdate {
      allow read: if signedIn();
      allow write: if false;
    }

    match /runtimeConfig/settlement {
      allow read: if signedIn();
      allow write: if false;
    }

    /* 일정 동기화 스위치 (2026-10-31). 쓰기는 대표 전용 통로(updateRuntimeConfig)뿐이다
       -- 서버의 일정이 기기 일정을 바꾸기 시작하는 자리라 실수로 눌러지면 안 된다. */
    match /runtimeConfig/scheduleSync {
      allow read: if signedIn();
      allow write: if false;
    }

    match /diagnostics/{userId}/reports/{reportId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          "schemaVersion", "createdAt", "app", "device", "logs", "logCount", "uid", "uploadedAt"
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt is string
        && request.resource.data.app is map
        && request.resource.data.device is map
        && request.resource.data.logs is list
        && request.resource.data.logs.size() <= 50
        && request.resource.data.logCount == request.resource.data.logs.size()
        && request.resource.data.uploadedAt is timestamp;
      allow update, delete: if false;
    }

    match /pilotMetrics/{userId}/attempts/{attemptId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          "schemaVersion", "uid", "date", "result", "flags", "confirmed", "latencyMs", "source", "updatedAt"
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.result in ["ok", "no_speech", "low_confidence", "failed"]
        && request.resource.data.flags is list
        && request.resource.data.flags.size() <= 3
        && request.resource.data.flags.hasOnly(["no_speech", "low_confidence", "tail_dropped"])
        && request.resource.data.confirmed is bool
        && request.resource.data.latencyMs is int
        && request.resource.data.latencyMs >= 0
        && request.resource.data.latencyMs <= 120000
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 40
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /organizations/{organizationId} {
      allow read: if isCentreStaff(organizationId);
      allow create, delete: if false;
      allow update: if hasRole(organizationId, ownerLevel())
        && immutable(["plan", "subscriptionStatus", "aiUsageCount"]);

      // Additive dual-write v1 paths. Existing top-level paths remain unchanged.
      match /clients/{clientId} {
        // See the locations block for why get and list are split. Here the
        // difference also narrows who may list: the get rule lets a member read
        // the one document linked to them, and a query cannot express "only my
        // own" without a filter to prove it. So listing the directory is for
        // staff, and a member still reads their own document one at a time.
        /* ── 없는 문서를 묻는 읽기 ────────────────────────────────────────
           엑셀 이관은 멱등해야 한다 -- 대표가 같은 파일을 두 번 올려도 앱에서
           고친 값이 되돌아가면 안 된다. 그래서 행마다 쓰기 전에 그 문서가 이미
           있는지 읽는다(migration-repository.js 의 runRows).

           그 읽기는 대부분 없는 문서를 향한다. 1차 업로드의 22행이 전부 새
           회원이면 22번 다 없는 문서다. 없는 문서에서 resource 는 null 이라
           resource.data.organizationId 를 보는 조건이 그 자리에서 거부되고,
           화면에는 permission-denied 한 줄로만 돌아온다. 실제로 22행 전부가
           그렇게 막혔다.

           그래서 직원에게는 null 을 허용한다. 이미 list 로 명부 전체를 볼 수
           있으므로 존재 여부가 새로 드러나는 정보가 아니다.

           회원 본인에게는 허용하지 않는다. clientId 가 csv_{연락처} 라서,
           없는 문서를 물을 수 있으면 "이 번호가 이 센터에 있는가" 를 캐는
           통로가 된다. 본인 문서는 있을 때만 읽힌다. */
        allow get: if isActiveMember(organizationId)
          && (
            (
              hasRole(organizationId, ["owner", "area_manager", "manager", "instructor", "staff"])
              && (resource == null || resource.data.organizationId == organizationId)
            )
            || (
              resource != null
              && resource.data.organizationId == organizationId
              && isOwnClientDocument(resource.data)
            )
          );
        allow list: if hasRole(organizationId, ["owner", "area_manager", "manager", "instructor", "staff"]);
        // Validate what is present rather than requiring a fixed set. The
        // registration screen writes seven fields; the dual-write adapter
        // writes a wider legacy shape (clientId, membershipBalance,
        // legacySource, updatedAt...) and sometimes omits the rest. hasOnly
        // would reject that adapter, and hasAll would reject a create that
        // predates these fields. A floor that checks each field it actually
        // sees stops a malformed write from either writer without closing a
        // door the migration still needs.
        // 등록은 대표·FC매니저. canRegisterClient 의 주석 참고 — 되돌릴 때는 그 목록
        // 하나만 바꾼다. 읽기와 수정은 그대로 가르치는 사람들에게 열려 있다.
        allow create: if request.resource.data.organizationId == organizationId
          && canRegisterClient(organizationId)
          // 만들 때도 못 켠다. 여기를 열어 두면 위의 immutable 이 무의미하다.
          && !("reviewDemo" in request.resource.data)
          && !("previousPhones" in request.resource.data)
          /* 담당 강사 목록도 앱이 만들지 않는다. 이 배열이 곧 "누가 이 회원을
             볼 수 있는가" 이므로, 앱에서 쓸 수 있으면 자기 uid 를 적어 넣어
             남의 회원을 여는 문이 된다. 채우는 것은 트리거뿐이다. */
          && !("instructorIds" in request.resource.data)
          && clientFieldsWellFormed();
        allow update: if resource.data.organizationId == organizationId
          && request.resource.data.organizationId == organizationId
          /* ── 연락처는 여기서 바뀌지 않는다 ────────────────────────────
             번호는 회원의 정체다. 회원 앱이 인증된 번호로 명부를 찾고
             (member-link-store.js), 엑셀 이관이 번호로 문서 id 를 만든다.
             그래서 바꾸는 일에는 셋이 함께 따라온다: 같은 번호를 쓰는 다른
             회원이 없는지 보는 **쿼리**, 이전 번호를 남기는 일, 그리고 이미
             연결된 계정을 끊는 일. 규칙은 셋 다 못 한다.

             그래서 문은 하나다 -- updateClientPhone callable (Admin SDK 는
             규칙을 지나지 않는다).

             값이 같으면 통과한다(affectedKeys). 기기 명부 동기화가 같은
             번호를 다시 보내도 막히지 않는다는 뜻인데, 그쪽은 아예 보내지
             않도록 고쳐 두었다 (firestore-adapters.js) -- 옛 번호를 든 기기가
             회원 메모를 고칠 때 그 수정이 통째로 거부되지 않게 하기 위해서다. */
          && phoneUnchanged()
          /* 심사용 표시는 앱에서 켜지지 않는다. 이 표시 하나로 그 회원이
             급여·발급 내역·매출에서 전부 빠지므로, 앱에서 켤 수 있으면
             **실적을 숨기는 버튼**이 된다. 켜는 것은 Firebase 콘솔에서
             대표가 직접 한다 -- 회원 하나에 한 번뿐인 일이다. */
          /* instructorIds 는 트리거만 쓴다. 규칙이 막지 않으면 강사가 자기
             uid 를 넣어 센터 전체를 여는 한 줄이 된다 -- 아래 list 가 이
             배열을 믿고 있기 때문이다. 값이 같으면 통과하므로(affectedKeys)
             문서를 통째로 다시 보내는 기기 동기화는 막히지 않는다. */
          && immutable(["previousPhones", "reviewDemo", "instructorIds"])
          && hasRole(organizationId, ["owner", "area_manager", "manager", "instructor", "staff"]);
        allow delete: if false;
      }

      /* ── 회원이 읽는 유일한 곳 ────────────────────────────────────────
         회원용 조회 앱이 이 문서 하나만 읽는다 (docs/member-app-design.md).

         왜 원본이 아니라 투영인가: 규칙은 문서 단위로만 열고 닫는다. passes 한
         문서에 remainingCount 와 baseUnitPrice·netContractPrice 가 같이 있어서,
         회원에게 그 문서를 열면 단가가 함께 나간다. 원장은 항목마다 unitPrice 와
         rule 을 들고 있어 더 심하다.

         그래서 functions/src/member-view.js 가 허용 목록으로 골라 만든 문서를
         여기에 두고, 회원은 그것만 읽는다.

         쓰기는 어느 역할에도 열지 않는다 -- 대표도 아니다. 이 문서를 쓰는 것은
         서버 트리거(Admin SDK)뿐이고, Admin SDK 는 규칙을 지나지 않는다. 앱
         쪽에 쓰기를 한 칸이라도 열면 그 경로로 들어온 값이 허용 목록을 거치지
         않고, 그러면 이 문서가 개인정보의 관문이라는 말이 거짓이 된다.

         list 도 닫는다. 회원은 자기 clientId 를 memberLinks 에서 알고 그 문서
         하나만 읽는다 -- 목록이 필요 없고, 열면 "내 것만" 을 증명할 필터를
         요구하게 된다. */
      match /memberViews/{clientId} {
        allow get: if signedIn()
          && resource.data.userId == request.auth.uid;
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /lessons/{lessonId} {
        // See the locations block for why get and list are split.
        /* 없는 문서도 읽게 둔다 (2026-10-31). 강사 일정을 서버에 쓸 때 앱은 확정된
           수업을 덮지 않으려고 트랜잭션 안에서 먼저 읽는다 -- 새 일정이면 아직
           없는 문서다. resource.data 만 보면 그 읽기가 거절되고, 새 일정이 전부
           permission-denied 로 끝났다 (lesson-schedule-repository.js). 없는 문서를
           읽어 알 수 있는 것은 "없다" 하나뿐이고, 센터 직원에게만 열린다. */
        allow get: if isCentreStaff(organizationId)
          && (resource == null || resource.data.organizationId == organizationId);
        allow list: if isCentreStaff(organizationId);
        /* ── 수정 번호 (2026-10-31, 동기화 1단계) ────────────────────────────
           일정 쓰기는 번호를 하나씩 올린다 (lesson-schedule-repository.js). 앱은
           트랜잭션 안에서 서버 번호와 견주어 다른 기기의 수정을 덮지 않는다. 규칙은
           같은 것을 한 번 더 본다: **번호 없이 쓰는 옛 탭은 거절된다** -- 옛 코드는
           서버를 보지 않고 덮어쓰고, 그것이 다른 PC 에서 고친 일정을 지운다.

           확정(deductPass)은 번호를 모른다. 그래서 "완료" 쓰기는 번호 대신 **같은
           배치에 실제 차감이 있는지**로 받는다 -- 번호 검사를 피해 완료로 바꾸는 다른
           길이 없게 (2026-10-31 대표 확인 요청):
           - 새 코드: settledPassId 의 원장 항목 {lessonId}_deduct 가 **이 배치에서 새로
             생긴다** (전에는 없고 뒤에는 있다). 번호는 그대로이거나 칸이 없어야 한다
           - 스토어 폰 앱 1.1.43: 회원권 id 를 싣지 않고 문서를 번호 없이 통째로 덮는다
             (set). 그 모양 그대로(칸 목록 고정)이고 참석 문서가 **이 배치에서 새로
             생길** 때만 받는다. 막으면 차감 · 회원권까지 한 배치가 통째로 실패한다.
             **1.1.43 이 사라지면(최소 버전 강제) 이 갈래는 지운다** -- 원장을 증명하지
             못하는 갈래다.

           완료를 다시 예정 · 취소로 돌리는 것은 확정 되돌리기뿐이고, 원장 보정과 같은
           선(대표 · 총괄매니저)이다. 일정 쓰기로는 완료가 되돌아가지 않는다. */
        function settledWithLedger() {
          return request.resource.data.get("settledPassId", "") is string
            && request.resource.data.get("settledPassId", "").size() > 0
            && !exists(/databases/$(database)/documents/organizations/$(organizationId)/passes/$(request.resource.data.settledPassId)/ledger/$(lessonId + "_deduct"))
            && existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/passes/$(request.resource.data.settledPassId)/ledger/$(lessonId + "_deduct"));
        }
        function legacyStoreAppSettlement() {
          return request.resource.data.keys().hasOnly([
              "organizationId", "lessonId", "clientId", "clientIds", "locationId",
              "instructorId", "startsAt", "status", "createdAt", "createdBy"
            ])
            && request.resource.data.get("lessonId", "") == lessonId
            && request.resource.data.get("clientId", "") is string
            && request.resource.data.get("clientId", "").size() > 0
            && !exists(/databases/$(database)/documents/organizations/$(organizationId)/lessons/$(lessonId)/participants/$(request.resource.data.clientId))
            && existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/lessons/$(lessonId)/participants/$(request.resource.data.clientId));
        }
        function completedBySettlement(previousRevision) {
          return legacyStoreAppSettlement()
            || (settledWithLedger()
              && (!("revision" in request.resource.data) || request.resource.data.revision == previousRevision));
        }
        allow create: if request.resource.data.organizationId == organizationId
          && hasRole(organizationId, ["owner", "area_manager", "manager", "instructor", "staff"])
          && (request.resource.data.get("status", "") == "completed"
            ? completedBySettlement(0)
            : request.resource.data.get("revision", 0) == 1);
        allow update: if resource.data.organizationId == organizationId
          && request.resource.data.organizationId == organizationId
          && hasRole(organizationId, ["owner", "area_manager", "manager", "instructor", "staff"])
          && (request.resource.data.get("status", "") == "completed"
            ? completedBySettlement(resource.data.get("revision", 0))
            : (resource.data.get("status", "") == "completed"
              ? hasRole(organizationId, ["owner", "area_manager"])
                && request.resource.data.get("revision", 0) == resource.data.get("revision", 0) + 1
              : request.resource.data.get("revision", 0) == resource.data.get("revision", 0) + 1));
        allow delete: if false;

        match /participants/{clientId} {
          // See the locations block for why get and list are split.
          allow get: if isCentreStaff(organizationId)
            && resource.data.organizationId == organizationId;
          allow list: if isCentreStaff(organizationId);
          allow create: if request.resource.data.organizationId == organizationId
            && request.resource.data.lessonId == lessonId
            && request.resource.data.clientId == clientId
            && hasRole(organizationId, ["owner", "area_manager", "manager", "instructor", "staff"]);
          allow update: if resource.data.organizationId == organizationId
            && request.resource.data.organizationId == organizationId
            && immutable(["lessonId", "clientId", "organizationId"])
            && hasRole(organizationId, ["owner", "area_manager", "manager", "instructor", "staff"]);
          allow delete: if false;
        }
      }

      // Event products change often, so they live as data instead of in code.
      // An existing product is never edited — it is archived and a new one added,
      // because passes already issued point at the terms it was sold under.
      // No unitPrice here: payroll rate comes from payCategory, and some of it
      // follows a per-instructor value.
      //
      // The one exception is etc, which is what a product is filed under when
      // the table has no rate for it — a trial session, a make-up pack. Those
      // were priced by hand at every single issue, so the rate lives on the
      // product instead. It is refused on every other category: a second place
      // to write a rate is a second answer, and passes issued from a product
      // whose number disagrees with the table cannot be corrected afterwards.
      match /products/{productId} {
        allow read: if isCentreStaff(organizationId);
        allow create: if request.resource.data.organizationId == organizationId
          && request.resource.data.keys().hasOnly([
            "organizationId", "name", "sessionType", "payCategory",
            "defaultSessions", "defaultPrice", "status", "createdAt", "createdBy",
            "baseUnitPrice"
          ])
          && request.resource.data.keys().hasAll([
            "organizationId", "name", "sessionType", "payCategory",
            "defaultSessions", "defaultPrice", "status", "createdAt", "createdBy"
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.sessionType in ["pt_1_1", "pt_2_1", "diosa"]
          && request.resource.data.payCategory in payCategories()
          // A 2:1 lesson priced at the 1:1 rate differs by about ten thousand won
          // per session, and one bad product spreads that to every pass issued
          // from it. service and etc attach to either shape; letmein is 1:1 only.
          /* 디오사는 그 둘뿐이다. 서비스도 기타도 붙지 않는다 -- 관리 수업의
             단가는 고정이고(20,000 / 35,000), 다른 카테고리가 섞이면 그 고정이
             깨진다. A 와 B 를 따로 파는 것이 요점이라, 한 상품이 둘 다를
             가리키는 길도 없다.
             Keep in sync with PAY_CATEGORIES_BY_SESSION_TYPE. */
          && (
            request.resource.data.sessionType == "pt_1_1"
              ? request.resource.data.payCategory in [
                "pt_1_1_new", "pt_1_1_repurchase_event", "pt_1_1_repurchase_normal",
                "service", "letmein", "etc"
              ]
            : request.resource.data.sessionType == "pt_2_1"
              ? request.resource.data.payCategory in [
                "pt_2_1_new", "pt_2_1_repurchase", "pt_2_1_repurchase_event",
                "service", "etc"
              ]
              : request.resource.data.payCategory in ["diosa_a", "diosa_b"]
          )
          && request.resource.data.defaultSessions is int
          && request.resource.data.defaultSessions > 0
          && request.resource.data.defaultPrice is int
          && request.resource.data.defaultPrice >= 0
          // Required on etc, refused everywhere else. Not optional on etc: a
          // product without it sends the issuer back to typing the rate by
          // hand, which is the thing this field exists to stop.
          && (
            request.resource.data.payCategory == "etc"
              ? (
                request.resource.data.baseUnitPrice is int
                && request.resource.data.baseUnitPrice >= 0
              )
              : !("baseUnitPrice" in request.resource.data)
          )
          && request.resource.data.status in ["active", "archived"]
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && canManageProducts(organizationId);
        // Only status moves, and it moves both ways. Everything else has to come
        // back unchanged — the set is closed, so this covers every field.
        allow update: if resource.data.organizationId == organizationId
          && request.resource.data.keys().hasOnly([
            "organizationId", "name", "sessionType", "payCategory",
            "defaultSessions", "defaultPrice", "status", "createdAt", "createdBy",
            "baseUnitPrice"
          ])
          && request.resource.data.keys().hasAll([
            "organizationId", "name", "sessionType", "payCategory",
            "defaultSessions", "defaultPrice", "status", "createdAt", "createdBy"
          ])
          // baseUnitPrice is not in the list above because products from before
          // it existed do not carry it. This says it cannot appear, vanish or
          // move — covering it without demanding it be there.
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.name == resource.data.name
          && request.resource.data.sessionType == resource.data.sessionType
          && request.resource.data.payCategory == resource.data.payCategory
          && request.resource.data.defaultSessions == resource.data.defaultSessions
          && request.resource.data.defaultPrice == resource.data.defaultPrice
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.status in ["active", "archived"]
          && canManageProducts(organizationId);
        allow delete: if false;
      }

      // PT passes (20-session packs and the like). Distinct from top-level
      // memberships, which mean organization membership and gate access.
      /* 강사-회원 쌍의 누적 진행 횟수.

         급여 판정이 "이 강사에게 이 회원 누적 20회 미만이면 신규 단가"를 묻는데,
         원장으로는 셀 수 없다 -- 항목이 회원권마다 흩어져 있고, 세려면 센터
         전체를 훑어야 한다. 그래서 차감할 때마다 여기서 한 칸 올린다.

         한 칸씩만 오른다. 여기서 임의의 값을 쓸 수 있으면 누구든 자기 단가를
         내릴 수도 올릴 수도 있고, 그것을 반증할 원장은 append-only 라 고칠 수
         없다. 예외는 대표뿐이다 -- 10월 이관 때 엑셀에서 옮겨 온 누적을 심어야
         하고, 그 값을 아는 사람은 대표다.

         문서 id 가 곧 강사-회원 쌍이라 한 쌍에 두 문서가 생길 수 없다. */
      match /instructorClientTotals/{totalId} {
        allow read: if isCentreStaff(organizationId);
        allow create: if request.resource.data.organizationId == organizationId
          && totalId == request.resource.data.instructorId + "_" + request.resource.data.clientId
          && request.resource.data.keys().hasOnly([
            "organizationId", "instructorId", "clientId", "sessions"
          ])
          && request.resource.data.keys().hasAll([
            "organizationId", "instructorId", "clientId", "sessions"
          ])
          && request.resource.data.instructorId is string
          && request.resource.data.instructorId.size() > 0
          && request.resource.data.clientId is string
          && request.resource.data.clientId.size() > 0
          && request.resource.data.sessions is int
          && (
            // 첫 수업.
            (
              hasRole(organizationId, ["owner", "area_manager", "manager", "instructor"])
              && request.resource.data.sessions == 1
            )
            // 이관. 엑셀에서 옮겨 온 누적을 대표가 심는다.
            || (hasRole(organizationId, ownerLevel()) && request.resource.data.sessions >= 0)
          );
        allow update: if resource.data.organizationId == organizationId
          && request.resource.data.organizationId == organizationId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["sessions"])
          && request.resource.data.sessions is int
          && (
            (
              hasRole(organizationId, ["owner", "area_manager", "manager", "instructor"])
              && request.resource.data.sessions == resource.data.sessions + 1
            )
            || (hasRole(organizationId, ownerLevel()) && request.resource.data.sessions >= 0)
          );
        allow delete: if false;
      }

      match /passes/{passId} {
        allow read: if isCentreStaff(organizationId);
        // The product fields are not settled yet, so require a floor rather than
        // closing the set with hasOnly.
        // A product carries the standard combination; what was actually sold is
        // recorded here, because the two are allowed to differ at issue time.
        allow create: if request.resource.data.organizationId == organizationId
          && request.resource.data.keys().hasAll([
            "organizationId", "clientId", "locationId", "productId",
            "totalSessions", "serviceSessions", "contractPrice",
            "paymentMethod", "purchaseRound", "status", "createdAt", "createdBy",
            // 발급 시점에 담당 강사가 정해진다. 없으면 차감한 회차가 누구의
            // 급여인지 알 수 없고, 교체 이력도 가리킬 대상이 없다.
            "instructorId",
            // 판정 4 가 쓰는 기준값이며, 이 회원권의 실제 단가가 아니다. 차감
            // 한 회차가 얼마인지는 그때 판정이 정한다 (deduction-pricing.js).
            // 그래도 발급 시점에 박아 둔다 -- 표를 다시 보면 그 사이 바뀐 단가가
            // 지난 회원권에 소급된다.
            "baseUnitPrice", "remainingCount",
            // 계약서에 적힌 만료일. 회원이 가장 자주 묻는 값이고 회원 앱에도 들어간다.
            "expiresAt",
            // 넘겨받은 회원권인가. 급여 판정 2 가 이것만 보고 단가를 정하므로
            // 차감할 때마다 원장을 뒤지지 않는다.
            "handedOver"
          ])
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.handedOver is bool
          && request.resource.data.baseUnitPrice is int
          && request.resource.data.baseUnitPrice >= 0
          && request.resource.data.remainingCount is int
          && request.resource.data.remainingCount >= 0
          // 이 회원권에서 이미 나간 service 차감 수. 발급 시점에는 0 이지만
          // 옛 회원권에는 이 필드가 없으므로 있을 때만 따진다.
          && (
            !("serviceUsed" in request.resource.data)
            || (request.resource.data.serviceUsed is int && request.resource.data.serviceUsed >= 0)
          )
          // 부가세를 뺀 공급가액. 부원장의 5:5 가 계약 금액이 아니라 이 값을
          // 반으로 접는다 -- 카드 110만이면 100만이다. 옛 회원권에는 없으므로
          // 있을 때만 따지고, 없으면 차감이 결제 수단에서 다시 계산한다.
          && (
            !("netContractPrice" in request.resource.data)
            || (
              request.resource.data.netContractPrice is int
              && request.resource.data.netContractPrice >= 0
              // 세금이 붙어 커질 수는 없다. 뒤집힌 값이 들어오면 부원장 단가가
              // 계약보다 높아지고, 원장은 고칠 수 없다.
              && request.resource.data.netContractPrice <= request.resource.data.contractPrice
            )
          )
          /* ── 듀엣: 회원권 하나에 회원 둘 ──────────────────────────────────
             계약서가 하나이고 회원권도 하나다. 30회 계약이면 두 명이 함께 쓰는
             30회이고, 수업 한 번에 1회 차감된다.

             clientId 를 배열로 갈아치우지 않고 clientIds 를 더한다. 아래 원장
             문이 항목을 회원권에 못 박고 있어서다
             (entry.clientId == getAfter(pass).data.clientId) -- 배열로 바꾸면
             그 조건이 무엇과 비교해야 하는지부터 답이 없고, 이미 쌓인 항목은
             영영 clientId 하나를 들고 있다.

             그래서 불변식 하나로 묶는다: clientIds[0] == clientId.
             src/data/schema/pass-clients.js 와 같은 규칙이다. */
          && (
            !("clientIds" in request.resource.data)
            || (
              request.resource.data.clientIds is list
              && request.resource.data.clientIds.size() >= 1
              // 듀엣이 둘이고 트리오는 아직 없다. MAX_PASS_CLIENTS 와 함께 고친다.
              && request.resource.data.clientIds.size() <= 2
              && request.resource.data.clientIds[0] == request.resource.data.clientId
              // 같은 사람을 두 번 적으면 회차는 하나인데 누적이 둘 오른다.
              && (
                request.resource.data.clientIds.size() == 1
                || request.resource.data.clientIds[1] != request.resource.data.clientId
              )
            )
          )
          && request.resource.data.instructorId is string
          && request.resource.data.instructorId.size() > 0
          && request.resource.data.totalSessions is int
          && request.resource.data.totalSessions > 0
          && request.resource.data.serviceSessions is int
          && request.resource.data.serviceSessions >= 0
          && request.resource.data.contractPrice is int
          && request.resource.data.contractPrice >= 0
          && request.resource.data.purchaseRound is int
          && request.resource.data.purchaseRound >= 1
          /* Keep in sync with STORED_PAYMENT_METHODS in
             functions/shared/constants.mjs. 규칙은 import 을 하지 못한다.

             zeropay · voucher 는 **옛 값**이다. 2026-10-27 에 기타결제(other)
             하나로 접었지만 목록에 남긴다 -- 이미 발급된 회원권이 들고 있고,
             양도는 원본의 결제 수단을 그대로 새 문서에 쓴다. 빼면 그 회원권을
             넘기는 길이 막힌다. */
          && request.resource.data.paymentMethod in [
            "card", "cash", "transfer", "other", "mixed", "zeropay", "voucher"
          ]
          /* ── 복합결제: 수단별 금액이 함께 와야 한다 ──────────────────────
             공급가액이 **카드 칸 하나로만** 정해진다 (deduction-pricing 의
             netContractPriceForMixed). 금액 없이 "복합결제" 만 들어오면 그
             회원권의 부원장 단가를 영영 셀 수 없고, 그때는 이미 팔린 뒤다. */
          && (
            request.resource.data.paymentMethod != "mixed"
            || "paymentBreakdown" in request.resource.data
          )
          && (
            !("paymentBreakdown" in request.resource.data)
            || (
              request.resource.data.paymentBreakdown is map
              // MIXED_PAYMENT_PARTS 와 같은 넷. 한 칸이라도 비면 합이 달라진다.
              && request.resource.data.paymentBreakdown.keys().hasOnly(["card", "transfer", "other", "cash"])
              && request.resource.data.paymentBreakdown.keys().hasAll(["card", "transfer", "other", "cash"])
              && request.resource.data.paymentBreakdown.card is int
              && request.resource.data.paymentBreakdown.card >= 0
              && request.resource.data.paymentBreakdown.transfer is int
              && request.resource.data.paymentBreakdown.transfer >= 0
              && request.resource.data.paymentBreakdown.other is int
              && request.resource.data.paymentBreakdown.other >= 0
              && request.resource.data.paymentBreakdown.cash is int
              && request.resource.data.paymentBreakdown.cash >= 0
            )
          )
          /* 잔금. 결제 합계와 어긋나도 막지 않는다 -- 얼마를 언제 받기로 했는지는
             FC 가 아는 일이라고 대표가 정했다 (2026-10-27). 음수만 막는다. */
          && (
            !("balance" in request.resource.data)
            || (request.resource.data.balance is int && request.resource.data.balance >= 0)
          )
          && (
            !("balanceEdited" in request.resource.data)
            || request.resource.data.balanceEdited is bool
          )
          /* 기타결제가 무엇이었는지. 제로페이 · 평생교육바우처를 하나로 접으면서
             그 글자가 가는 자리다. Keep in sync with PAYMENT_NOTE_MAX. */
          && (
            !("paymentNote" in request.resource.data)
            || (
              request.resource.data.paymentNote is string
              && request.resource.data.paymentNote.size() <= 100
            )
          )
          && request.resource.data.status is string
          && request.resource.data.createdAt == request.time
          // 발급은 대표·FC매니저. canIssuePass 의 주석 참고 — 바꿀 때는 그 목록
          // 하나만 바꾼다.
          && canIssuePass(organizationId);
        /* ── 세션업 기간은 왜 여기 없는가 (2026-10-27) ───────────────────
           세션업은 **이 문을 아예 지나지 않는다.** totalSessions 는 아래 어느
           갈래에도 없어 클라이언트가 쓸 수 없고, 짝이 되는 원장 항목의 종류
           "sessionup" 도 아래 허용 목록에 없다. 유일한 길이 Admin SDK
           (functions/src/pass-admin.js 의 runSessionUp)이고, 그쪽은 규칙을
           지나지 않는다. 그래서 기간 판정은 서버에 있다.

           **쓸 수 없어서가 아니다.** 사용 회차는 회원권 문서 네 숫자로
           정해지므로 규칙도 셀 수 있다 (하위 컬렉션을 훑지 않는다):

             서비스사용 = serviceUsed (없으면 총+서비스−잔여 를 서비스로 자름)
             서비스잔여 = 서비스 − 서비스사용, 잔여를 넘지 않게
             사용       = 총회차 − (잔여 − 서비스잔여)
             한도       = 총회차 >= 10 ? 6 : 3        // 사용 <= 한도면 가능

           클라이언트가 회차를 쓰는 문이 언젠가 열리면 그때 이 식을 여기에
           옮긴다. 지금 넣으면 아무 요청도 통과하지 않는 죽은 조건이 된다. */
        // The owner's reach is unchanged. A manager may move one field and
        // nothing else: handovers happen while the owner is not at the centre,
        // and the transfer is safe because it rewrites no past entry — every
        // deducted session already carries the instructor it was taught by.
        allow update: if resource.data.organizationId == organizationId
          && request.resource.data.organizationId == organizationId
          /* ── 어느 갈래로 오든 지키는 것 ────────────────────────────────
             아래 역할 갈래 **밖에** 둔다. 대표 갈래는 `hasRole(["owner"])`
             한 줄이라 아무 값이나 통과했고, 그래서 대표 계정은 잔여를 -5 로
             쓰거나 만료일을 아무 값으로나 바꿀 수 있었다. 화면이 없었을 뿐
             문은 열려 있었다.

             잔여가 음수가 되면 회원 앱이 "-5회 남음" 을 그리고, 원장의
             합(발급 − 차감)과도 어긋난다. 원장은 append-only 라 그 어긋남은
             고칠 수 없다.

             만료일이 날짜가 아니면 회원 앱의 만료 표시와 운영중/만료 판정이
             통째로 무너진다 -- 둘 다 이 값 하나를 읽는다. */
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(["remainingCount"])
            || (
              request.resource.data.remainingCount is int
              && request.resource.data.remainingCount >= 0
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(["expiresAt"])
            || request.resource.data.expiresAt is timestamp
          )
          /* 누가 이 회원권을 쓰는지는 발급으로만 정해진다. 나중에 바꾸면 이미
             차감된 회차가 누구의 것이었는지가 소급해서 달라지고, 원장은
             append-only 라 그 어긋남을 고칠 수 없다.

             듀엣이 깨지는 경우는 이 문을 여는 것이 아니라 회원권을 취소하고
             다시 발급하는 것으로 처리한다 -- 대표만 할 수 있고 이력이 남는다.
             나중에 제대로 넣을 때 여기에 문을 하나 더 내면 된다. */
          && immutable(["clientId", "clientIds"])
          && (
            hasRole(organizationId, ownerLevel())
            // 담당 교체. 넘겨받았다는 사실이 함께 남아야 급여 판정이 그것을 볼
            // 수 있다 -- 둘 중 하나만 바뀌면 단가가 조용히 틀린다.
            || (
              hasRole(organizationId, ["manager"])
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["instructorId", "handedOver"])
              && request.resource.data.handedOver == true
            )
            /* 만료일. FC매니저도 옮긴다 -- 연장과 홀딩은 운영이 하는
               일이고, 그때마다 대표를 불러야 하면 회원이 기다린다.

               회차는 못 건드린다. 그것은 돈이 오가는 자리라 차감 보정·취소·
               양도와 같은 선에 둔다.

               같은 배치에 expiry 항목이 함께 오는지는 규칙이 묻지 못한다 --
               회원권 문서가 새 항목의 id 를 모르고, 하위 컬렉션을 훑을 수도
               없다. 그 짝은 저장소가 맞춘다. 규칙이 지키는 것은 "날짜가
               아닌 값은 못 들어온다" 까지다 (위 불변식). */
            || (
              hasRole(organizationId, ["manager"])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["expiresAt"])
            )
            /* ── 잔여 조정 (FC매니저) ──────────────────────────────────
               2026-10-26 대표 결정. 만료일과 같은 선이 됐다 -- 둘 다 운영이
               매일 하는 일이고, 둘 다 사유와 이력이 함께 남는다.

               숫자 자체의 불변식(정수 · 0 이상)은 위 역할 갈래 **밖에** 있어
               여기서 다시 묻지 않는다. 짝이 되는 원장 항목(type "adjust",
               사유 필수)은 그쪽 문이 지킨다. */
            || (
              hasRole(organizationId, ["manager"])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["remainingCount"])
            )
            /* ── 회원권 취소 (FC매니저) ────────────────────────────────
               **갓 발급하고 한 회차도 안 쓴 것만** (2026-10-26). 자기가 방금
               잘못 발급한 것을 되무르는 자리다.

               조건은 **바뀌기 전 문서**로 본다 (resource.data). 바뀐 쪽은
               잔여가 이미 0 이라 "안 썼는가" 를 물을 수 없다.

               상태와 잔여가 함께 움직여야 한다 -- 상태만 바꾸면 원장의
               합(발급 − 차감 − 취소)과 잔여가 어긋나고, 그 어긋남은 고칠 수
               없다. */
            || (
              hasRole(organizationId, ["manager"])
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status", "remainingCount"])
              && resource.data.status == "active"
              && request.resource.data.status == "cancelled"
              && request.resource.data.remainingCount == 0
              && freshlyIssuedPass(resource.data)
            )
            // Attendance. Whoever teaches may spend one session and nothing
            // else — never two, and never back upwards. A pass that could be
            // topped up here would let anyone grant themselves lessons the
            // member never bought, and the ledger that proves it is append-only.
            //
            // A service session moves a second counter in the same write. The
            // centre pays for one service session per pass; every one after that
            // is unpaid, and serviceUsed is what decides which is which. Written
            // apart from the deduction it could lag behind and pay twice, so it
            // travels in the same update and is checked the same way: up by one,
            // never further, never back down.
            || (
              hasRole(organizationId, ["owner", "area_manager", "manager", "instructor"])
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["remainingCount", "serviceUsed"])
              && request.resource.data.remainingCount is int
              && request.resource.data.remainingCount == resource.data.remainingCount - 1
              && request.resource.data.remainingCount >= 0
              && (
                !request.resource.data.diff(resource.data).affectedKeys().hasAny(["serviceUsed"])
                || (
                  request.resource.data.serviceUsed is int
                  // 옛 회원권에는 이 필드가 없다. 없던 자리에서 올리면 1 이다.
                  && request.resource.data.serviceUsed == (
                    "serviceUsed" in resource.data ? resource.data.serviceUsed + 1 : 1
                  )
                )
              )
            )
          );
        allow delete: if false;

        // Append-only, and these numbers feed payroll. Nothing can be corrected
        // afterwards, so the write itself is the only place to reject a bad body.
        match /ledger/{entryId} {
          allow read: if isCentreStaff(organizationId);
          allow create: if request.resource.data.organizationId == organizationId
            && request.resource.data.passId == passId
            && request.resource.data.keys().hasOnly([
              "organizationId", "passId", "clientId", "locationId", "type", "delta",
              "category", "unitPrice", "rule", "lessonId", "instructorId",
              "fromInstructorId", "toInstructorId",
              // 양도가 들고 가는 둘. 나간 회차가 어디로 갔는가.
              "toPassId", "toClientId",
              // 고치는 항목이 들고 가는 둘. 무엇을 되돌리는지와 왜 되돌리는지.
              "correctsEntryId", "reason",
              // 만료일 변경이 들고 가는 둘. 어디서 어디로 옮겼는가.
              "previousExpiresAt", "newExpiresAt",
              /* 처리한 사람의 **역할**. createdBy 는 uid 만 들고 있어서, 반년
                 뒤 그 줄을 보는 사람은 누른 사람이 그때 무엇이었는지 알 수
                 없다 -- 소속 문서는 지금 상태만 들고 있고, 그 사이에 역할이
                 바뀌거나 퇴사했을 수 있다.

                 총괄매니저가 생기면서 그 질문이 실제로 생겼다: 잔여 조정과
                 발급 취소를 대표가 했는지 총괄매니저가 했는지가 "총괄매니저
                 처리 내역" 화면의 전부다.

                 **없어도 된다.** 이 필드가 생기기 전 항목이 이미 쌓여 있고,
                 옛 앱은 보내지 않는다. 다만 보낼 때는 거짓말을 못 한다
                 (아래에서 소속 문서와 대조한다) -- 거짓 역할이 남으면 기록이
                 없는 것보다 해롭다. auditLogs 의 actorRole 과 같은 판단이다. */
              "actorRole",
              "occurredAt", "createdAt", "createdBy"
            ])
            && request.resource.data.keys().hasAll([
              "organizationId", "passId", "clientId", "locationId", "type", "delta",
              "occurredAt", "createdAt", "createdBy"
            ])
            // 역할은 적어도 되고 안 적어도 되지만, 적으면 자기 역할이어야 한다.
            && (
              !("actorRole" in request.resource.data)
              || request.resource.data.actorRole == membership(organizationId).data.role
            )
            // The entry says whose lesson it was. The ledger is append-only, so a
            // wrong name here can never be corrected — it is checked against the
            // pass the entry hangs off rather than trusted from the caller.
            //
            // getAfter, not get. An issue entry is written in the same batch as
            // the pass it hangs off — that is the point of the batch, since a
            // pass without its issue entry has no basis for its remaining count
            // and the ledger cannot be filled in later. get() reads the database
            // as it was before the commit, so the pass is not there yet and the
            // whole batch dies on a null. getAfter() reads the state the commit
            // is producing, which is the state this entry is actually about.
            && request.resource.data.clientId == getAfter(
              /databases/$(database)/documents/organizations/$(organizationId)/passes/$(passId)
            ).data.clientId
            /* 옛 빌드가 옛 단가로 쓰는 것을 막는다 (위 minimumLedgerBuild).
               **차감에만 건다** -- 발급·양도·보정은 금액 판정이 없거나 대표가
               누르는 일이고, 거기까지 막으면 켜는 날 센터가 통째로 멈춘다. */
            && (request.resource.data.type != "deduct" || appBuildAllowed(organizationId))
            && request.resource.data.type is string
            // Keep in sync with LEDGER_ENTRY_TYPE in src/data/schema/constants.js.
            && request.resource.data.type in [
              "issue", "deduct", "transfer", "handover", "correction", "cancel",
              // 숫자 맞추기와 만료일 옮기기. 수업이 아니므로 급여에 잡히지
              // 않는다 -- PAYROLL_ENTRY_TYPES 가 허용 목록이라 애초에 질의에
              // 걸리지 않는다 (payroll-repository.js).
              "adjust", "expiry"
            ]
            /* 양도의 두 칸은 양도에만 있다. hasOnly 는 "있어도 된다" 만
               말하므로, 차감 항목에 toPassId 가 붙어도 통과해 버린다 -- 그러면
               회차가 어디로 갔는지를 가리키는 칸이 아무 데나 생기고, 그것을
               읽는 화면은 가지 않은 회차를 갔다고 말한다. */
            && (
              request.resource.data.type == "handover"
              || !request.resource.data.keys().hasAny(["toPassId", "toClientId"])
            )
            /* 되돌리는 항목은 대표만 쓴다. 강사와 매니저가 스스로 되돌릴 수
               있으면 기록의 의미가 없다 -- 잘못 누른 사람이 그것을 지울 수
               있다는 뜻이기 때문이다.

               원래 항목은 그대로 남는다. 이것은 "고쳤다"가 아니라 "고친 기록"이고,
               update 와 delete 는 여전히 아무에게도 열려 있지 않다.

               사유는 비워 둘 수 없다. 반년 뒤 이 줄을 보는 사람에게 "왜
               되돌렸나"가 없으면, 되돌린 것 자체가 실수인지 알 수 없다.
               나머지 종류에는 사유 칸이 없다 -- 자유 문장은 열어 둔 만큼 들어온다. */
            && (
              request.resource.data.type in ["correction", "cancel"]
                ? (
                  request.resource.data.reason is string
                  && request.resource.data.reason.size() > 0
                  // Keep in sync with LEDGER_REASON_MAX in constants.js.
                  && request.resource.data.reason.size() <= 200
                  && (
                    hasRole(organizationId, ownerLevel())
                    /* FC매니저는 **취소만**, 그것도 갓 발급하고 안 쓴 것만
                       (2026-10-26). 보정(correction)은 이미 일어난 수업의
                       급여를 되돌리는 일이라 대표·총괄에 그대로 묶여 있다. */
                    || (
                      request.resource.data.type == "cancel"
                      && hasRole(organizationId, ["manager"])
                      && freshlyIssuedPass(get(/databases/$(database)/documents/organizations/$(organizationId)/passes/$(passId)).data)
                    )
                  )
                )
              /* 조정과 만료일 변경도 사유가 필수다. 다만 역할이 갈린다 --
                 만료일은 FC매니저도 옮긴다. 위 갈래에 끼워 넣으면 매니저가
                 차감 보정까지 쓰게 되므로 문을 따로 낸다. */
              : request.resource.data.type in ["adjust", "expiry"]
                ? (
                  request.resource.data.reason is string
                  && request.resource.data.reason.size() > 0
                  && request.resource.data.reason.size() <= 200
                  /* 잔여 조정도 FC매니저가 한다 (2026-10-26 대표 결정).
                     만료일과 같은 선이 됐다 -- 둘 다 운영이 매일 하는 일이고,
                     둘 다 사유와 이력이 함께 남는다.

                     차감 보정은 여기 없다. 그쪽은 위 갈래이고 대표·총괄만이다. */
                  && hasRole(organizationId, ["owner", "area_manager", "manager"])
                  && !("correctsEntryId" in request.resource.data)
                )
                : !("reason" in request.resource.data)
                  && !("correctsEntryId" in request.resource.data)
            )
            // Why this amount. It cannot be worked out again later — the
            // accumulated count only ever goes up, and the deputy flag and the
            // service counter both move on — so the reason is written down at
            // the moment it decided something. Entries from before this field
            // existed do not have it, so it is optional; when it is there it
            // has to be one the engine can return.
            //
            // 이 목록은 **차감을 막는 목록이다.** 여기 없는 값이 오면 상품이
            // 안 만들어지는 것으로 끝나지 않고 그 수업의 차감이 통째로
            // 거부되고, 화면에는 permission-denied 한 줄로만 도착한다.
            //
            // 2026-10-12 에 그 일이 났다. 이 목록은 2026-10-04 에 그때 있던
            // 다섯으로 적힌 뒤 한 번도 안 늘었는데, 그 뒤로 판정이 넷 늘었다
            // (service_first · diosa_fixed · duet_event_fixed ·
            // senior_title_event). 점장·팀장은 1:1 재등록(이벤트) 수업을
            // **한 건도 확정할 수 없었다** -- 그 조합만 senior_title_event 가
            // 이기기 때문이고, 같은 회원권을 일반 강사가 하면 통과했다.
            // payCategories() 와 똑같은 모양의 사고다 (2026-10-10).
            //
            // tests/rules 가 이 목록과 PRICING_RULE 이 같은지 본다. 판정을
            // 늘릴 때 여기를 같이 안 고치면 거기서 깨진다.
            && (
              !("rule" in request.resource.data)
              || request.resource.data.rule in [
                "service_first", "service_already_used",
                "deputy_director",
                "diosa_fixed", "duet_event_fixed", "senior_title_event",
                "handed_over", "new_to_instructor", "base_category"
              ]
            )
            && request.resource.data.delta is int
            && request.resource.data.createdBy == request.auth.uid
            // createdAt says when it was recorded and the server stamps it, so a
            // client cannot backdate. occurredAt says when the lesson happened and
            // the client does send it — instructors enter a whole day at night —
            // so it is fenced to a window instead. Payroll totals by occurredAt.
            && request.resource.data.createdAt == request.time
            && request.resource.data.occurredAt is timestamp
            && request.resource.data.occurredAt <= request.time
            && request.resource.data.occurredAt > request.time - duration.value(7, "d")
            /* 종류마다 들고 가야 하는 것이 다르다. 교체와 취소는 돈이 오가지
               않아 category 와 unitPrice 에 넣을 참값이 없다. 필수 목록을 채우자고
               지어내면 급여가 그 허구를 카테고리별로 묶어 센다. */
            && (
              request.resource.data.type == "transfer"
                ? (
                  request.resource.data.delta == 0
                  && request.resource.data.keys().hasAll(["fromInstructorId", "toInstructorId"])
                  && request.resource.data.fromInstructorId is string
                  && request.resource.data.toInstructorId is string
                  && request.resource.data.fromInstructorId != request.resource.data.toInstructorId
                  && !("category" in request.resource.data)
                  && !("unitPrice" in request.resource.data)
                  && !("lessonId" in request.resource.data)
                  // 담당 교체는 운영하는 사람의 판단이다. 강사가 자기 앞으로
                  // 회원권을 옮길 수 있으면 급여가 스스로 움직인다.
                  && hasRole(organizationId, ["owner", "area_manager", "manager"])
                )
              : request.resource.data.type == "handover"
                ? (
                  /* 회원권 양도. 이 회원권에서 회차가 나가고, 같은 배치에서
                     받는 회원의 새 회원권(issue)이 만들어진다.

                     delta 는 음수다. 그런데 deduct 가 아니다 -- 수업이
                     일어나지 않았으므로 급여가 나가지 않고, 그래서 category 와
                     unitPrice 에 넣을 참값이 없다. 필수 목록을 채우자고
                     지어내면 급여가 그 허구를 카테고리별로 묶어 센다.

                     어디로 갔는지를 반드시 남긴다. 이것이 없으면 회차가 줄어든
                     사실만 남고 그 회차가 어디로 갔는지는 아무도 모른다 --
                     회원이 "내 회차 어디 갔냐" 고 물을 때 답할 것이 없다.

                     남은 회차보다 많이 나갈 수 없다. get() 은 커밋 전의 값을
                     읽고, 그것이 바로 "양도 직전에 남아 있던 회차" 다. 서비스
                     회차를 빼는 일은 규칙이 셀 수 없어 저장소가 맡는다
                     (pass-transfer.js 의 transferableSessions).

                     대표만 한다. 회원 사이에 돈이 오가는 일이라 차감 보정·취소와
                     같은 선이다. */
                  request.resource.data.delta < 0
                  && request.resource.data.delta >= -get(
                    /databases/$(database)/documents/organizations/$(organizationId)/passes/$(passId)
                  ).data.remainingCount
                  && request.resource.data.keys().hasAll(["toPassId", "toClientId"])
                  && request.resource.data.toPassId is string
                  && request.resource.data.toPassId.size() > 0
                  && request.resource.data.toClientId is string
                  && request.resource.data.toClientId.size() > 0
                  // 자기 자신에게 넘기는 것은 양도가 아니다.
                  && request.resource.data.toClientId != request.resource.data.clientId
                  && request.resource.data.toPassId != passId
                  && !("category" in request.resource.data)
                  && !("unitPrice" in request.resource.data)
                  && !("lessonId" in request.resource.data)
                  && !("correctsEntryId" in request.resource.data)
                  && hasRole(organizationId, ownerLevel())
                )
              : request.resource.data.type == "cancel"
                ? (
                  /* 남은 회차를 전부 거둔다. 그 숫자는 회원권이 들고 있으므로
                     caller 에게 묻지 않는다 -- get() 은 커밋 전의 값을 읽고,
                     그것이 바로 "취소 직전에 남아 있던 회차"다. 회원권을 0 으로
                     내리는 쓰기는 같은 배치에 있다.

                     이미 차감된 회차가 있는지는 규칙이 셀 수 없다. 원장을 세는
                     일이라 여기서는 막지 못하고, 저장소가 마지막 문이다
                     (pass-repository.js 의 isCancellablePass). */
                  request.resource.data.delta == -get(
                    /databases/$(database)/documents/organizations/$(organizationId)/passes/$(passId)
                  ).data.remainingCount
                  && !("category" in request.resource.data)
                  && !("unitPrice" in request.resource.data)
                  && !("lessonId" in request.resource.data)
                  && !("correctsEntryId" in request.resource.data)
                )
              /* ── 잔여 조정 ──────────────────────────────────────────
                 수업이 아니라 숫자 맞추기다. 실제 잔여와 장부가 어긋났을 때
                 대표가 맞추는 자리이고, 그래서 category·unitPrice 가 없다 --
                 넣으면 급여가 그 허구를 카테고리별로 묶어 센다.

                 원래 기록은 그대로 둔다. 원장은 덧붙이기만 하므로 조정도 한
                 줄로 남고, 무엇을 얼마나 왜 옮겼는지가 함께 남는다.

                 0 은 조정이 아니다. 아무것도 안 바뀐 줄이 사유만 달고 쌓이면
                 나중에 읽는 사람이 그것을 세게 된다. */
              : request.resource.data.type == "adjust"
                ? (
                  request.resource.data.delta != 0
                  && !("category" in request.resource.data)
                  && !("unitPrice" in request.resource.data)
                  && !("lessonId" in request.resource.data)
                  && !("previousExpiresAt" in request.resource.data)
                  && !("newExpiresAt" in request.resource.data)
                )
              /* ── 만료일 변경 ────────────────────────────────────────
                 회차가 움직이지 않으므로 delta 는 0 이다. 옮긴 자취를 두 칸에
                 남긴다 -- 이것이 없으면 "언제부터 이 날짜였나" 를 물을 때 답할
                 것이 없고, 회원 앱에는 새 날짜만 조용히 나타난다.

                 홀딩도 이 길로 온다. 기간만큼 뒤로 미는 것이고, 홀딩이었다는
                 사실은 사유에 적는다. */
              : request.resource.data.type == "expiry"
                ? (
                  request.resource.data.delta == 0
                  && request.resource.data.previousExpiresAt is timestamp
                  && request.resource.data.newExpiresAt is timestamp
                  // 같은 날짜로 바꾸는 것은 변경이 아니다.
                  && request.resource.data.newExpiresAt != request.resource.data.previousExpiresAt
                  && !("category" in request.resource.data)
                  && !("unitPrice" in request.resource.data)
                  && !("lessonId" in request.resource.data)
                )
              : (
                  request.resource.data.keys().hasAll(["category", "unitPrice", "instructorId"])
                  && request.resource.data.category in payCategories()
                  && request.resource.data.unitPrice is int
                  && request.resource.data.unitPrice >= 0
                  && (
                    request.resource.data.type == "issue"
                      // 발급 항목은 회원권 문서와 한 배치로 쓰인다. 회원권 쪽만
                      // 좁히면 매니저가 이미 있는 회원권에 "20회 발급" 한 줄을
                      // 덧붙일 수 있고, 회원 이력 화면이 그것을 그대로 읽는다.
                      // 두 반쪽은 같은 문을 통과해야 한다.
                      /* ── 0 회차 발급을 받는다 (2026-10-27 대표 결정 4) ──
                         이관 업로드가 **남은 횟수를 그대로** 발급으로 적는다
                         (migration-repository 의 applyPassMigration). 다 쓴
                         회원권은 그 값이 0 이고, 전에는 여기서 거부되어 회원권
                         문서까지 같은 배치로 함께 거부됐다 -- 장유점 43줄이
                         permission-denied 로 멈춘 것이 이것이다.

                         0 은 아무 회차도 더하지 않으므로 위 주석이 막으려던
                         일("20회 발급" 한 줄 덧붙이기)과 무관하다. 음수는 그대로
                         막는다 -- 발급이 회차를 빼앗을 수는 없다. */
                      ? request.resource.data.delta >= 0 && canIssuePass(organizationId)
                    : request.resource.data.type == "correction"
                      /* 정확히 한 회차를 되돌리고, 무엇을 되돌리는지 가리킨다.
                         단가와 카테고리는 원래 항목과 같은 값이어야 급여에서 그
                         회차가 정확히 상쇄된다 -- 표를 다시 읽으면 그 사이 바뀐
                         단가로 빼게 되고 차액이 남는다.

                         문서 id 가 <원래항목>_correction 이라 같은 항목을 두 번
                         보정하면 같은 자리로 가고, update 가 막는다. 세지 않고
                         구조로 막는 것이라 놓칠 수가 없다. */
                      ? (
                        request.resource.data.delta == 1
                        && request.resource.data.correctsEntryId is string
                        && request.resource.data.correctsEntryId.size() > 0
                        && entryId == request.resource.data.correctsEntryId + "_correction"
                        && !("lessonId" in request.resource.data)
                      )
                      : request.resource.data.delta < 0 && "lessonId" in request.resource.data
                  )
                  && hasRole(organizationId, ["owner", "area_manager", "manager", "instructor"])
                )
            );
          allow update, delete: if false;
        }
      }

      match /lessonNotes/{noteId} {
        // See the locations block for why get and list are split. As with
        // clients, a query cannot prove "only the notes about me", so listing
        // is for the roles that teach and run the centre; a member still reads
        // their own note one document at a time.
        // 없는 문서를 읽는 것은 거부가 아니다.
        //
        // 화면은 "회원에게 보낼 말" 칸을 열 때 이전에 보낸 말을 먼저 읽는데,
        // 처음 쓰는 수업에는 그 문서가 없다. 그때 resource 는 null 이고
        // resource.data 를 보는 순간 규칙이 오류로 끝나 거부된다 -- 앱에는
        // permission-denied 로 도착해서 "아직 없음" 과 "권한 없음" 이 같은
        // 얼굴이 된다. 저장도 함께 막혔다: 리포지토리가 쓰기 전에 먼저
        // 읽기 때문이다(createdAt 을 다시 보내지 않으려고).
        //
        // 없는 문서에 대해서는 센터 사람인지만 본다. 아직 아무것도 없으므로
        // 새어 나갈 것이 없고, 회원은 자기 것이 생긴 뒤에만 읽는다.
        allow get: if isActiveMember(organizationId)
          && (
            resource == null
              ? hasRole(organizationId, ["owner", "area_manager", "manager", "instructor"])
              : (
                resource.data.organizationId == organizationId
                && (
                  hasRole(organizationId, ["owner", "area_manager", "manager", "instructor"])
                  || resource.data.userId == request.auth.uid
                )
              )
          );
        allow list: if hasRole(organizationId, ["owner", "area_manager", "manager", "instructor"]);
        allow create: if request.resource.data.organizationId == organizationId
          && hasRole(organizationId, ["owner", "area_manager", "manager", "instructor"]);
        allow update: if resource.data.organizationId == organizationId
          && request.resource.data.organizationId == organizationId
          && request.auth.uid == resource.data.createdBy
          && immutable(["clientId", "lessonId", "createdBy", "createdAt"]);
        allow delete: if false;
      }

      /* ── 기기 청소 직전의 사본 ────────────────────────────────────────
         강사 기기에서 남의 회원을 지우기 전에 그 회원들을 한 벌 남긴다.
         지우는 것은 기록이 이미 센터에 있는 회원뿐이지만, 강사가 그 회원에게
         적어 둔 레거시 수업 기록은 그 기기와 그 사람의 백업에만 있다 --
         되돌릴 자리가 없으면 지울 수 없다.

         **users/{uid} 밑에 두지 않는다.** 거기 두면 강사가 남의 회원 기록을
         계속 가지게 되고, 이 작업 전체가 없애려는 것이 그것이다. 그래서 조직
         쪽이고 읽는 사람은 대표뿐이다.

         만들기만 한다. 고칠 수도 지울 수도 없다 -- 되돌릴 사본이 덮어써지면
         그것은 사본이 아니다. expireAt 에 TTL 을 걸어 90일 뒤에 사라진다. */
      match /scopeSnapshots/{snapshotId} {
        allow get, list: if hasRole(organizationId, ownerLevel());
        allow create: if isCentreStaff(organizationId)
          && request.resource.data.organizationId == organizationId
          // 남의 이름으로 남기지 못한다. 누가 무엇을 지웠는지가 이 문서의 요점이다.
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            "organizationId", "userId", "members", "clientIds", "createdAt", "expireAt"
          ])
          && request.resource.data.keys().hasAll([
            "organizationId", "userId", "members", "createdAt", "expireAt"
          ])
          && request.resource.data.createdAt == request.time
          && request.resource.data.expireAt is timestamp
          && request.resource.data.members is list
          && request.resource.data.members.size() > 0;
        allow update, delete: if false;
      }

      /* ── 공지사항 ──────────────────────────────────────────────────────
         대표·총괄매니저가 쓰고, 센터 사람이 읽는다. 강사 앱이 기간 안의 안 읽은
         공지를 팝업으로 한 번 띄운다.

         **대상으로 거르지 않는다.** 지점·직급·역할은 문서 안의 값이고, list
         규칙은 질의가 제약하지 않은 필드를 평가할 수 없다 (이 파일 머리말) --
         거르려 들면 질의 전체가 거부되어 공지가 통째로 안 뜬다. 거르는 것은
         화면의 몫이고(pendingNotices), 여기서 지키는 것은 "이 센터 사람인가"
         까지다. 공지는 센터가 모두에게 알리려고 쓰는 글이라 그 선이 맞다.

         지우지 않는다. 읽음 기록이 가리킬 글이 사라지면 "읽음 N명" 이 무엇의
         N 인지 알 수 없다 -- 끝낼 때는 status 를 ended 로 둔다. */
      match /notices/{noticeId} {
        allow get: if isCentreStaff(organizationId)
          && resource.data.organizationId == organizationId;
        allow list: if isCentreStaff(organizationId);
        allow create: if request.resource.data.organizationId == organizationId
          && hasRole(organizationId, ownerLevel())
          && request.resource.data.keys().hasOnly([
            "organizationId", "title", "body", "imageUrl", "linkUrl",
            "startsOn", "endsOn", "important",
            "locationIds", "titles", "roles",
            "status", "createdAt", "createdBy", "updatedAt", "updatedBy"
          ])
          && request.resource.data.keys().hasAll([
            "organizationId", "title", "body", "status", "createdAt", "createdBy"
          ])
          && noticeBodyWellFormed()
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid;
        /* 고칠 수 있다. 공지는 사람이 쓰는 글이라 오타가 나고, 그것을 못 고치면
           같은 공지를 두 번 쓰게 된다 -- 그러면 읽은 사람에게 또 뜬다.

           만든 사람과 만든 시각은 움직이지 않는다. */
        allow update: if resource.data.organizationId == organizationId
          && request.resource.data.organizationId == organizationId
          && hasRole(organizationId, ownerLevel())
          && immutable(["createdAt", "createdBy"])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "title", "body", "imageUrl", "linkUrl",
            "startsOn", "endsOn", "important",
            "locationIds", "titles", "roles",
            "status", "updatedAt", "updatedBy"
          ])
          && noticeBodyWellFormed()
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;

        /* ── 읽음 ────────────────────────────────────────────────────────
           **본인만 자기 것을 만든다.** 남이 대신 적으면 "읽음 N명" 이 거짓이
           되고, 그 숫자가 이 기능의 전부다.

           문서 id 가 곧 공지-사람 쌍이라 한 사람이 두 건을 만들 수 없다.
           고치지도 지우지도 않는다 -- 읽은 것을 안 읽은 것으로 되돌리는 일은
           없고, 있으면 그것은 집계를 흔드는 길이다. */
        match /reads/{readId} {
          allow get: if isCentreStaff(organizationId)
            && resource.data.organizationId == organizationId;
          allow list: if hasRole(organizationId, ownerLevel());
          allow create: if request.resource.data.organizationId == organizationId
            && isCentreStaff(organizationId)
            && readId == noticeId + "_" + request.auth.uid
            && request.resource.data.keys().hasOnly([
              "organizationId", "noticeId", "userId", "readAt"
            ])
            && request.resource.data.keys().hasAll([
              "organizationId", "noticeId", "userId", "readAt"
            ])
            && request.resource.data.noticeId == noticeId
            && request.resource.data.userId == request.auth.uid
            // 기기 시계를 믿지 않는다. 믿으면 "언제 읽었나" 가 아무 값이나 된다.
            && request.resource.data.readAt == request.time;
          allow update, delete: if false;
        }
      }

      match /locations/{locationId} {
        // get and list are split on purpose. A list rule is evaluated against
        // what the query guarantees, not against the documents it returns, so a
        // `resource.data` test the query does not constrain can never be
        // satisfied — the whole query is refused with "Property organizationId
        // is undefined on object", which reaches the screen as an empty picker.
        // The path already scopes these documents to one organization, so the
        // membership check alone is what a list can honestly enforce.
        allow get: if isCentreStaff(organizationId)
          && resource.data.organizationId == organizationId;
        allow list: if isCentreStaff(organizationId);
        /* 지점을 만들고 고치는 것은 **대표·총괄매니저뿐이다** (2026-10-26
           대표 결정). FC매니저는 목록을 읽기만 한다.

           전에는 FC매니저도 쓸 수 있었다. 화면은 주지 않았지만(강사 관리가
           대표 전용) 문은 열려 있었고, 규칙으로만 막혀 있지 않은 문은 다음
           화면이 생기는 날 조용히 열린다. 지금은 FC매니저가 맡은 지점으로
           자기 범위가 정해지므로, 지점을 만들 수 있다는 것은 **자기 범위를
           자기가 넓히는 길**이기도 하다.

           읽기(get·list)는 그대로 isCentreStaff 다 -- 회원권 발급과 회원
           등록의 지점 칩이 그것으로 뜬다. */
        allow create: if request.resource.data.organizationId == organizationId
          && hasRole(organizationId, ownerLevel());
        allow update: if resource.data.organizationId == organizationId
          && request.resource.data.organizationId == organizationId
          && hasRole(organizationId, ownerLevel());
        allow delete: if false;
      }
    }

    // The rate history hangs off a membership, whose path does not carry the
    // organization. Reading the parent gives the rule an organization without
    // touching resource.data, so the same condition works for get and list —
    // see the list note near the top of this file.
    function membershipOrganizationId(membershipDocumentId) {
      return get(/databases/$(database)/documents/memberships/$(membershipDocumentId)).data.organizationId;
    }

    /* 그 소속 문서의 주인을 건드려도 되는가. 위 mayManageMembership 과 같은
       판정이고, 대상을 경로에서 읽어 온다는 것만 다르다 -- 총괄매니저는 대표와
       다른 총괄매니저의 단가 이력에 손대지 못한다.

       같은 문서를 두 번 읽지만 요청당 접근 수는 한 번으로 센다 (같은 경로). */
    function mayManageMembershipDocument(membershipDocumentId) {
      return mayManageMembership(
        membershipOrganizationId(membershipDocumentId),
        get(/databases/$(database)/documents/memberships/$(membershipDocumentId)).data
      );
    }

    // A collection-group query does not reach the nested rule above it, so the
    // pay screen — which reads one instructor's month across every pass at once
    // rather than opening each pass in turn — needs its own match. It grants no
    // more than the nested rule already does: an active member of the same
    // organization. The instructor clause is the one a group query can prove,
    // because the query filters on instructorId; owners and managers get the
    // organization-wide branch for the payroll screen that comes later.
    //
    // organizationId must be constrained by the query or the whole read is
    // refused — see the list note near the top of this file.
    match /{path=**}/ledger/{entryId} {
      allow read: if isActiveMember(resource.data.organizationId)
        && (
          resource.data.instructorId == request.auth.uid
          || hasRole(resource.data.organizationId, ["owner", "area_manager", "manager"])
        );
    }

    /* ── 계정과 회원을 잇는 기록 ──────────────────────────────────────────
       전화번호 인증을 마친 회원이 어느 clientId 에 이어졌는가, 또는 왜 이어지지
       못했는가 (docs/member-app-design.md 4장).

       본인만 읽는다. 문서 id 가 곧 uid 라 resource 를 보지 않고 경로로 판정할
       수 있다 -- 없는 문서를 물어도 같은 답이 나오고, 남의 링크는 애초에 가리킬
       수 없다.

       쓰기는 전부 닫는다. 이 문서를 쓰는 것은 linkMemberAccount(Admin SDK)
       뿐이다. 클라이언트에게 한 칸이라도 열면 아무 번호나 적어 남의 회원권에
       붙을 수 있다 -- 그 함수가 인증 토큰의 전화번호만 믿는 이유와 같다. */
    match /memberLinks/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /memberships/{membershipDocumentId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || hasRole(resource.data.organizationId, ["owner", "area_manager", "manager"])
      );
      /* ── 강사를 붙이는 문 ────────────────────────────────────────────────
         지금까지 소속 문서는 콘솔이나 이관 도구(Admin SDK)로만 생겼다. 대표가
         앱에서 강사를 붙이려면 이 문이 있어야 한다.

         대표만 연다. 그리고 만드는 것은 언제나 남의 소속이다 -- 자기 소속을
         자기가 만들 수 있으면 아무나 아무 센터의 대표가 된다.

         role 은 owner 를 뺀 목록이다. 대표를 앱에서 세우지 않는다: 이 문으로
         owner 를 만들 수 있으면 대표 한 사람이 아무 계정이나 자기와 같은 자리에
         올릴 수 있고, 그것을 되돌리는 문은 없다. 대표 교체는 콘솔의 일로 남긴다.

         급여를 움직이는 두 필드(fullRoomRate · isDeputyDirector)는 여기서 받지
         않는다. 아래 각자의 문으로만 들어오고, 그 문들은 rateHistory 와 감사
         항목을 같은 배치에 요구한다 -- 여기서 함께 받으면 이력 없이 단가가
         정해지는 길이 하나 생긴다. 추가 화면은 소속을 먼저 만들고 단가를 그
         다음에 넣는다.
         ────────────────────────────────────────────────────────────────── */
      /* 총괄매니저도 강사를 붙인다. 단, **자기와 같은 자리는 세우지 못한다** --
         role 목록을 아래에서 가른다 (대표: area_manager 까지, 총괄매니저:
         그 아래만). 열어 두면 대표가 모르는 사이에 그 자리가 늘고, 되돌리는
         문은 없다. */
      allow create: if hasRole(request.resource.data.organizationId, ownerLevel())
        && (
          hasRole(request.resource.data.organizationId, ["owner"])
          || !(request.resource.data.role in ownerLevel())
        )
        // 문서 id 가 곧 조직-사용자 쌍이다. 규칙의 membershipId() 와 같은 형식이
        // 아니면 isActiveMember 가 영영 찾지 못하는 소속이 만들어진다.
        && membershipDocumentId == request.resource.data.organizationId + "_" + request.resource.data.userId
        && request.resource.data.keys().hasOnly([
          "organizationId", "userId", "role", "status",
          /* 붙일 때부터 대표가 정한 이름이다. 표시가 없으면 그 강사가 앱을
             처음 여는 순간 로그인 계정 이름으로 덮어써진다 (nameSetByOwner). */
          "displayName", "displayNameBy", "title", "locationId",
          /* 맡은 지점들. **FC매니저만 둘 이상일 수 있다** (2026-10-26).
             한 칸짜리 locationId 는 그대로 둔다 -- 옛 앱이 깔린 폰이 아직
             그것만 쓰고, 지우면 그 폰들의 지점이 통째로 사라진다. */
          "locationIds",
          "createdAt", "createdBy"
        ])
        && request.resource.data.keys().hasAll([
          "organizationId", "userId", "role", "status",
          "displayName", "createdAt", "createdBy"
        ])
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.userId != request.auth.uid
        /* owner 는 여기 없다. 대표를 앱에서 세우지 않는다 (위 머리말).
           area_manager 는 **대표만** 쓸 수 있다 -- 바로 위 갈래가 가른다.
           Keep in sync with ROLES in functions/shared/constants.mjs. */
        && request.resource.data.role in ["instructor", "manager", "staff", "area_manager"]
        && request.resource.data.status == "active"
        // 이름이 없으면 목록이 uid 로 되돌아간다. 대표가 보고 고를 수 있어야 한다.
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60
        // 적으면 "owner" 여야 한다. 다른 값은 그 칸의 뜻을 흐린다.
        && (!("displayNameBy" in request.resource.data) || nameSetByOwner(request.resource.data))
        && membershipProfileWellFormed()
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if false;
      // Three doors, each one field wide.
      //
      // fullRoomRate decides what a repurchase lesson pays its instructor, so
      // an instructor must not set their own — only the owner.
      //
      // isDeputyDirector decides far more: a deputy is paid half the contract
      // price per session regardless of category, accumulated count or handover,
      // so the flag outranks every other pay rule. Only the owner sets it, and
      // not on themselves — an owner who also teaches would otherwise be able to
      // put their own lessons on the 5:5 split without anyone else in the loop.
      // fullRoomRate has no such clause because it is a number the owner is
      // expected to maintain; this one is a promotion.
      //
      // displayName is the member's own name, kept here rather than read from
      // users/{uid}. Rules cannot hide fields on a read: opening that document
      // so an owner could see a name would hand them the phone number and the
      // e-mail sitting beside it. A membership is already readable by the
      // owners and managers who need the name, so the name comes to them
      // instead — and only its subject may write it.
      //
      // Nothing else about a membership — role, status, organization — travels
      // through either door.
      allow update: if (
          mayManageMembership(resource.data.organizationId, resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["fullRoomRate"])
          && request.resource.data.fullRoomRate is int
          && request.resource.data.fullRoomRate >= 0
        ) || (
          mayManageMembership(resource.data.organizationId, resource.data)
          && resource.data.userId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isDeputyDirector"])
          && request.resource.data.isDeputyDirector is bool
        ) || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName"])
          // 대표가 정한 이름은 본인도 덮지 못한다 (위 nameSetByOwner 머리말).
          && !nameSetByOwner(resource.data)
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 60
        ) || (
          /* ── 앱 버전 기록 ──────────────────────────────────────────────
             강사 전원이 새 앱을 쓰는지 대표가 볼 수 있어야 회원 범위 규칙을
             켤 수 있다. 낡은 앱은 그 규칙 아래서 **통째로 멈추므로**, 모르는
             채 켜면 강사는 고칠 자리에 있지 않은 고장을 만난다.

             본인 문서의 세 칸만이다. 역할도 지점도 급여도 여기서 움직이지
             않는다 -- 위의 displayName 문과 같은 모양이다.

             lastSeenAt 은 request.time 이어야 한다. 기기 시계를 그대로 믿으면
             "방금 열었다" 를 언제든 적을 수 있고, 그러면 이 값으로 판단하는
             일이 의미를 잃는다. */
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["appVersion", "appBuild", "lastSeenAt"])
          && request.resource.data.appVersion is string
          && request.resource.data.appVersion.size() > 0
          && request.resource.data.appVersion.size() <= 40
          && request.resource.data.appBuild is string
          && request.resource.data.appBuild.size() > 0
          && request.resource.data.appBuild.size() <= 40
          && request.resource.data.lastSeenAt == request.time
        ) || (
          /* 대표가 고치는 세 칸: 이름·직함·지점. 함께 움직여도 되는 것들이라
             한 문으로 묶었다 -- 강사 관리 화면의 수정 시트가 이 셋을 한 번에
             저장한다. 급여를 움직이는 두 필드는 여기 없다. 그것들은 각자의
             문으로 가고, 그 문은 rateHistory 와 감사 항목을 함께 요구한다.

             이름을 대표도 쓸 수 있는 것은 위 본인 문과 겹치지만 부딪치지
             않는다: 강사가 앱을 한 번도 안 열었으면 이름을 채울 사람이 대표뿐이고,
             열었으면 본인이 쓴 이름이 그대로 남는다. */
          mayManageMembership(resource.data.organizationId, resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["displayName", "title", "locationId", "locationIds", "displayNameBy"])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 60
          /* 이름을 적으면 **누가 정했는지도 적는다.** 표시 없이 들어온 이름은
             로그인 동기화가 그대로 덮어 쓰고, 대표는 자기가 고친 것이 왜
             되돌아갔는지 알 수 없다. */
          && nameSetByOwner(request.resource.data)
          && membershipProfileWellFormed()
        ) || (
          /* 퇴사. active 와 revoked 사이만 오간다.
             다른 상태(invited·suspended)는 이 화면이 만들지 않으므로 열지 않는다.

             자기 자신에게는 쓸 수 없다. 대표가 자기 소속을 회수하면 그 센터에
             owner 가 없어지고, 되돌릴 문은 아무 데도 없다 -- isDeputyDirector
             문이 자기 자신을 막는 것과 같은 이유이고, 여기서는 더 되돌릴 수 없다.

             회수해도 그 사람이 남긴 원장과 급여는 그대로다. 원장은 append-only
             이고 각 항목이 그때의 instructorId 를 들고 있다. */
          mayManageMembership(resource.data.organizationId, resource.data)
          && resource.data.userId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
          && request.resource.data.status in ["active", "revoked"]
        ) || (
          /* ── 총괄매니저 지정·해제 ──────────────────────────────────────
             **대표만이다.** 총괄매니저는 대표와 같은 권한이라, 총괄매니저가
             총괄매니저를 세울 수 있으면 대표가 모르는 사이에 그 자리가 늘고
             되돌리는 문은 없다.

             오가는 것은 area_manager 와 그 아래 사이뿐이다. owner 는 양쪽
             어디에도 없다 -- 대표를 앱에서 세우거나 내리지 않는다 (create
             머리말과 같은 선이다).

             기본 지점(locationId)이 같은 문으로 온다. 지정 화면이 역할과
             기본 지점을 한 번에 저장하는데, 둘을 따로 쓰면 하나가 실패했을
             때 역할만 바뀌고 지점이 비는 상태가 남는다. */
          hasRole(resource.data.organizationId, ["owner"])
          && resource.data.userId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role", "locationId"])
          && (
            (request.resource.data.role == "area_manager"
              && resource.data.role in ["instructor", "manager"])
            || (resource.data.role == "area_manager"
              && request.resource.data.role in ["instructor", "manager"])
          )
          && membershipProfileWellFormed()
        );

      // Append-only. The rate changes when an instructor passes a grading, and
      // "since when was it this much" has to stay answerable. This is a record,
      // never a payroll input — payroll reads the unitPrice frozen into each
      // ledger entry, so raising a rate never moves a settled month.
      //
      // Two kinds of change share this collection, because they answer the same
      // question: what decided this instructor's rate, and since when. Being made
      // a deputy is a rate change — from that moment the full-room amount is not
      // used at all and half the contract price takes its place. Split into two
      // collections, a dispute would have to merge them by time, and whoever
      // forgot to merge would read one and answer that nothing changed.
      //
      // An entry carries one pair or the other, never both and never neither.
      match /rateHistory/{entryId} {
        allow read: if mayManageMembershipDocument(membershipDocumentId);
        allow create: if mayManageMembershipDocument(membershipDocumentId)
          && request.resource.data.organizationId == membershipOrganizationId(membershipDocumentId)
          && request.resource.data.keys().hasOnly([
            "organizationId", "userId", "previousRate", "newRate",
            "previousDeputyDirector", "newDeputyDirector",
            "effectiveFrom", "changedBy", "createdAt"
          ])
          && request.resource.data.keys().hasAll([
            "organizationId", "userId",
            "effectiveFrom", "changedBy", "createdAt"
          ])
          && request.resource.data.userId is string
          && request.resource.data.userId.size() > 0
          && (
            (
              "newRate" in request.resource.data
              && !("newDeputyDirector" in request.resource.data)
              && !("previousDeputyDirector" in request.resource.data)
              && request.resource.data.newRate is int
              && request.resource.data.newRate >= 0
              // null means there was no rate before this one.
              && (
                request.resource.data.previousRate == null
                || (request.resource.data.previousRate is int && request.resource.data.previousRate >= 0)
              )
              && request.resource.data.previousRate != request.resource.data.newRate
            ) || (
              "newDeputyDirector" in request.resource.data
              && !("newRate" in request.resource.data)
              && !("previousRate" in request.resource.data)
              && request.resource.data.newDeputyDirector is bool
              // null means nobody had decided either way before this entry.
              && (
                request.resource.data.previousDeputyDirector == null
                || request.resource.data.previousDeputyDirector is bool
              )
              && request.resource.data.previousDeputyDirector != request.resource.data.newDeputyDirector
            )
          )
          && request.resource.data.changedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          // createdAt is when it was recorded; effectiveFrom is when the raise
          // actually took effect, which can be a few days earlier because a
          // grading result arrives before anyone opens the app.
          && request.resource.data.effectiveFrom is timestamp
          && request.resource.data.effectiveFrom <= request.time
          && request.resource.data.effectiveFrom > request.time - duration.value(7, "d");
        allow update, delete: if false;
      }
    }

    match /assessments/{assessmentId} {
      allow read: if isActiveMember(resource.data.organizationId)
        && (
          hasRole(resource.data.organizationId, ["owner", "area_manager", "manager", "instructor"])
          || resource.data.userId == request.auth.uid
        );
      allow create: if hasRole(request.resource.data.organizationId, ["owner", "area_manager", "manager", "instructor"]);
      allow update: if sameOrganization()
        && immutable(["clientId", "createdBy", "createdAt"])
        && hasRole(resource.data.organizationId, ["owner", "area_manager", "manager", "instructor"]);
      allow delete: if false;
    }

    match /assessmentMedia/{mediaId} {
      allow read: if isActiveMember(resource.data.organizationId)
        && (
          hasRole(resource.data.organizationId, ["owner", "area_manager", "manager", "instructor"])
          || resource.data.userId == request.auth.uid
        );
      allow create, update, delete: if false;
    }

    match /inbodyMeasurements/{measurementId} {
      allow read: if isActiveMember(resource.data.organizationId)
        && (
          hasRole(resource.data.organizationId, ["owner", "area_manager", "manager", "instructor"])
          || resource.data.userId == request.auth.uid
        );
      allow create: if hasRole(request.resource.data.organizationId, ["owner", "area_manager", "manager", "instructor"]);
      allow update, delete: if false;
    }

    match /exercisePrograms/{programId} {
      allow read: if isActiveMember(resource.data.organizationId)
        && (
          hasRole(resource.data.organizationId, ["owner", "area_manager", "manager", "instructor"])
          || resource.data.userId == request.auth.uid
        );
      allow create: if hasRole(request.resource.data.organizationId, ["owner", "area_manager", "manager", "instructor"]);
      allow update: if sameOrganization()
        && immutable(["sourceRecommendationId", "createdBy", "createdAt"])
        && hasRole(resource.data.organizationId, ["owner", "area_manager", "manager", "instructor"]);
      allow delete: if false;
    }

    match /exerciseHistory/{historyId} {
      allow read: if isActiveMember(resource.data.organizationId)
        && (
          hasRole(resource.data.organizationId, ["owner", "area_manager", "manager", "instructor"])
          || resource.data.userId == request.auth.uid
        );
      allow create: if hasRole(request.resource.data.organizationId, ["owner", "area_manager", "manager", "instructor"]);
      allow update, delete: if false;
    }

    match /aiRecommendations/{recommendationId} {
      allow read: if isActiveMember(resource.data.organizationId)
        && (
          hasRole(resource.data.organizationId, ["owner", "area_manager", "manager", "instructor"])
          || resource.data.userId == request.auth.uid
        );
      allow create, update, delete: if false;
    }

    match /aiFeedback/{feedbackId} {
      allow read: if hasRole(resource.data.organizationId, ["owner", "area_manager", "manager", "instructor"]);
      allow create: if hasRole(request.resource.data.organizationId, ["owner", "area_manager", "manager", "instructor"])
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /outcomes/{outcomeId} {
      allow read: if hasRole(resource.data.organizationId, ["owner", "area_manager", "manager", "instructor"]);
      allow create, update, delete: if false;
    }

    match /memberGoals/{goalId} {
      allow read: if isActiveMember(resource.data.organizationId)
        && (
          hasRole(resource.data.organizationId, ["owner", "area_manager", "manager", "instructor"])
          || resource.data.userId == request.auth.uid
        );
      allow create: if hasRole(request.resource.data.organizationId, ["owner", "area_manager", "manager", "instructor"]);
      allow update, delete: if false;
    }

    match /memberProgress/{progressId} {
      allow read: if isActiveMember(resource.data.organizationId)
        && (
          hasRole(resource.data.organizationId, ["owner", "area_manager", "manager", "instructor"])
          || resource.data.userId == request.auth.uid
        );
      allow create, update, delete: if false;
    }

    match /events/{eventId} {
      allow read: if isCentreStaff(resource.data.organizationId);
      allow create, update, delete: if false;
    }

    // Keep in sync with AUDIT_ACTION in src/data/repositories/audit-repository.js.
    //
    // Issue, handover and deduction are deliberately absent: they already live
    // in passes/{passId}/ledger, which is append-only and carries more than an
    // audit entry would. Writing them twice would add a write to the button
    // pressed most often in this app and leave two records of one event that can
    // disagree. The audit screen merges this collection with the ledger instead.
    function auditActions() {
      return [
        "deputy_director_set", "full_room_rate_set", "migration_uploaded",
        // 강사 관리. 누가 센터에 붙고, 무엇으로 불리고, 언제 나갔는가. 소속
        // 문서는 현재 상태만 들고 있어 그 이력을 답할 수 없다.
        "member_added", "member_profile_changed", "member_revoked",
        /* 대표가 그 강사 대신 비밀번호 재설정 메일을 보냈다. 그 사람의
           로그인을 건드리는 일이라 누가 언제 했는지가 남아야 한다.

           mayRecordAudit 이 이미 ownerLevel 로 좁히므로 여기 넣는 것만으로
           대표·총괄매니저뿐이다. 이메일 주소를 담을 칸은 열지 않는다 --
           누구인지는 targetId(uid) 가 말한다. */
        "password_reset_sent",
        /* 총괄매니저 지정·해제. 아래 mayRecordAudit 이 이것만 대표로 좁힌다 --
           총괄매니저가 자기 자리를 세운 기록을 지어내지 못하게. */
        "area_manager_set",
        /* 누적 보정. 급여 판정 3 이 보는 숫자를 손으로 고치는 일이고, 그
           숫자 하나가 그 회원의 남은 수업 단가를 전부 정한다 -- 20 을 넘기면
           카테고리 단가, 아니면 신규 단가다.

           전·후·사유가 전부 필수다 (아래 adjustmentWellFormed). 기록 없이
           고칠 수 있으면 그 숫자는 아무 때나 움직일 수 있는 값이 된다. */
        "instructor_total_adjusted",
        /* 회원권 상품 추가 · 보관 (2026-10-27 대표). **FC매니저도 한다** --
           아래 mayRecordAudit 이 이 둘만 canManageProducts 로 넓힌다.

           상품 문서는 createdBy 로 "누가 만들었나" 를 들고 있지만, 보관은
           status 한 칸만 바꾸므로 누가 언제 내렸는지가 어디에도 없었다.
           Keep in sync with AUDIT_ACTION in audit-repository.js. */
        "product_added", "product_archived"
      ];
    }

    /* 누적을 왜 고쳤는가. **열거값이다** -- 이 목록에는 자유 문장 칸이 하나도
       없고, 하나 열면 언젠가 거기에 회원 이름이 들어간다.
       Keep in sync with TOTAL_ADJUST_REASON in audit-repository.js. */
    function totalAdjustReasons() {
      return ["service_sessions_removed", "migration_overwrite", "manual_correction"];
    }

    /* 누적 보정 항목이 들고 와야 하는 것. 다른 동작에는 요구하지 않는다 --
       동작마다 말이 되는 칸이 다르고, 말이 안 되는 칸을 0 으로 채우면 화면이
       그것을 진짜 값으로 읽는다. */
    function adjustmentWellFormed(data) {
      return data.action != "instructor_total_adjusted" || (
        data.keys().hasAll(["targetId", "clientId", "previousAmount", "amount", "reason"])
        && data.reason in totalAdjustReasons()
        // 바꾸지 않은 보정은 기록하지 않는다. 같은 값을 적은 줄은 목록만 늘린다.
        && data.previousAmount != data.amount
      );
    }

    // 무엇을 했는지에 따라 남길 수 있는 사람이 다르다. 규칙은 그 조작 자체를
    // 허용하는 규칙과 같은 역할을 요구한다 -- 할 수 없는 일의 기록을 지어낼 수는
    // 없어야 한다. 지금은 셋 다 대표의 조작이라 셋 다 대표뿐이고, 발급·차감이
    // 나중에 이 목록에 들어온다면 그때는 매니저·강사가 함께 열려야 한다.
    function mayRecordAudit(organizationId, action) {
      return action in auditActions()
        && (
          action == "area_manager_set"
            // 그 조작 자체가 대표만이므로 기록도 대표만이다.
            ? hasRole(organizationId, ["owner"])
            /* 상품을 만들고 내리는 것은 FC매니저도 한다 (canManageProducts).
               기록을 대표에게만 열어 두면 FC매니저의 쓰기가 통째로 거부되고 --
               조작과 기록이 한 배치라 상품까지 못 만든다 -- 그러면 기록을
               빼는 쪽으로 고치게 된다. 조작할 수 있는 사람이 기록도 남긴다. */
            : action in ["product_added", "product_archived"]
              ? canManageProducts(organizationId)
              : hasRole(organizationId, ownerLevel())
        );
    }

    match /auditLogs/{logId} {
      // 대표만 본다. 센터 전체의 조작 이력은 한 사람의 것이 아니다.
      //
      // 이 절이 resource.data.organizationId 를 보기 때문에, 조직을 좁히지 않은
      // list 는 평가할 것이 없어 거부된다. 그것이 class B 의 강제 장치다 --
      // 이 파일 머리말 참고.
      allow read: if hasRole(resource.data.organizationId, ownerLevel());

      // Append-only. 고칠 수 없다는 것이 이 컬렉션의 값어치 전부다.
      allow create: if mayRecordAudit(request.resource.data.organizationId, request.resource.data.action)
        // 남의 이름으로 기록하지 않는다.
        && request.resource.data.actorId == request.auth.uid
        // 역할도 대조한다. 거짓말한 역할이 남으면 기록이 없는 것보다 해롭다.
        && request.resource.data.actorRole == membership(request.resource.data.organizationId).data.role
        // 클라이언트가 만든 시각은 받지 않는다. 소급 기록이 가능해진다.
        && request.resource.data.createdAt == request.time
        // Keep in sync with AUDIT_FIELDS in audit-repository.js. 자유 문장 칸이
        // 하나도 없다 -- 있으면 언젠가 거기에 회원 이름이 들어간다.
        && request.resource.data.keys().hasOnly([
          "organizationId", "actorId", "actorRole", "action", "createdAt",
          "locationId", "targetId", "clientId",
          "amount", "previousAmount", "succeeded", "failed", "enabled", "stage",
          // 직함. 열거값이라 자유 문장이 아니다 — 이 집합에 문장 칸을 하나
          // 열면 언젠가 거기에 회원 이름이 들어간다.
          "title",
          // 누적을 왜 고쳤는가. 역시 열거값이다 (totalAdjustReasons).
          "reason"
        ])
        && request.resource.data.keys().hasAll([
          "organizationId", "actorId", "actorRole", "action", "createdAt"
        ])
        && request.resource.data.action in auditActions()
        && (!("amount" in request.resource.data)
          || (request.resource.data.amount is int && request.resource.data.amount >= 0))
        && (!("previousAmount" in request.resource.data)
          || (request.resource.data.previousAmount is int && request.resource.data.previousAmount >= 0))
        && (!("succeeded" in request.resource.data)
          || (request.resource.data.succeeded is int && request.resource.data.succeeded >= 0))
        && (!("failed" in request.resource.data)
          || (request.resource.data.failed is int && request.resource.data.failed >= 0))
        && (!("enabled" in request.resource.data) || request.resource.data.enabled is bool)
        // Keep in sync with MEMBERSHIP_TITLE in src/data/schema/constants.js.
        && (!("title" in request.resource.data)
          || request.resource.data.title in ["instructor", "team_lead", "branch_manager"])
        && (!("reason" in request.resource.data)
          || request.resource.data.reason in totalAdjustReasons())
        && adjustmentWellFormed(request.resource.data)
        && (!("targetId" in request.resource.data) || request.resource.data.targetId is string)
        && (!("clientId" in request.resource.data) || request.resource.data.clientId is string)
        && (!("locationId" in request.resource.data) || request.resource.data.locationId is string)
        && (!("stage" in request.resource.data) || request.resource.data.stage is string);
      allow update, delete: if false;
    }

    match /dailyStats/{statId} {
      allow read: if hasRole(resource.data.organizationId, ["owner", "area_manager", "manager", "instructor", "staff"]);
      allow create, update, delete: if false;
    }

    match /teacherPatterns/{patternId} {
      allow read: if hasRole(resource.data.organizationId, ["owner", "area_manager", "manager", "instructor"]);
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
