rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membershipId(organizationId) {
      return organizationId + "_" + request.auth.uid;
    }

    function membership(organizationId) {
      return get(/databases/$(database)/documents/memberships/$(membershipId(organizationId)));
    }

    function isActiveMember(organizationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/memberships/$(membershipId(organizationId)))
        && membership(organizationId).data.status == "active";
    }

    function hasRole(organizationId, roles) {
      return isActiveMember(organizationId)
        && membership(organizationId).data.role in roles;
    }

    // Keep in sync with PAY_CATEGORY in src/data/schema/constants.js. Rules
    // files cannot import, so products and the pass ledger share this instead.
    function payCategories() {
      return [
        "pt_1_1_new", "pt_1_1_repurchase_event", "pt_1_1_repurchase_normal",
        "pt_2_1_new", "pt_2_1_repurchase", "service", "letmein", "etc"
      ];
    }

    // Keep in sync with CLIENT_STATUS in src/data/schema/constants.js. The
    // registration screen only ever produces the first three
    // (CLIENT_STATUS_FOR_CREATE); deleted and inactive exist because migrated
    // data carries them, so the rule has to keep accepting them.
    function clientStatuses() {
      return ["active", "hold", "ended", "deleted", "inactive"];
    }

    // Each clause passes when the field is absent. See the clients block for
    // why this is a floor and not a fixed set.
    function clientFieldsWellFormed() {
      return (!("name" in request.resource.data)
          || (request.resource.data.name is string && request.resource.data.name.size() > 0))
        // Stored digits-only, so one number has one spelling. A number split
        // across 010-1234-5678 and 01012345678 quietly breaks both the search
        // and the same-name check the registration screen shows.
        && (!("phone" in request.resource.data)
          || request.resource.data.phone is string)
        // The adapter writes null when a legacy member has no location yet.
        && (!("locationId" in request.resource.data)
          || request.resource.data.locationId == null
          || request.resource.data.locationId is string)
        && (!("status" in request.resource.data)
          || request.resource.data.status in clientStatuses())
        // A client-made timestamp is refused even when it is accurate — it is
        // the one field a caller could use to backdate a record.
        && (!("createdAt" in request.resource.data)
          || request.resource.data.createdAt == request.time)
        // Nobody files a registration under someone else's name.
        && (!("createdBy" in request.resource.data)
          || request.resource.data.createdBy == request.auth.uid);
    }

    // ── list is evaluated against the query, not the results ──────────────
    // A `resource.data` test inside a read rule cannot be satisfied by a
    // collection query unless the query itself constrains that same field.
    // Firestore does not return "false" in that case — it raises "Property X is
    // undefined on object" and refuses the whole query, which reaches a screen
    // as an empty list. An empty collection passes quietly, so the defect stays
    // invisible until the first document exists.
    //
    // Two shapes, two fixes:
    //
    //   A. Documents under /organizations/{organizationId}/…
    //      The path already pins the organization, so the field test is
    //      redundant for a list. get keeps it; list drops it.
    //      Done: clients, locations, lessons, lessons/participants, lessonNotes.
    //
    //   B. Top-level documents that carry organizationId in the body.
    //      The rule is correct as written and needs no change — but the caller
    //      MUST query with where("organizationId", "==", …) so the rule has
    //      something to evaluate. memberships already works this way.
    //      Nothing to fix here; the requirement lives in the repository.
    //
    // Still carrying the class-B requirement, with no list caller yet. Whoever
    // writes the first one must filter on organizationId (and, where the rule
    // also allows "my own document", accept that a list is role-only):
    //   assessments, assessmentMedia, inbodyMeasurements, exercisePrograms,
    //   exerciseHistory, aiRecommendations, aiFeedback, outcomes, memberGoals,
    //   memberProgress, events, auditLogs, dailyStats, teacherPatterns.
    //
    // Already list-safe, no resource.data in their read rule: organizations,
    // products, passes, passes/ledger, runtimeConfig, and everything under
    // /users/{userId}.

    function sameOrganization() {
      return request.resource.data.organizationId == resource.data.organizationId;
    }

    function immutable(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isOwnClientDocument(data) {
      return signedIn() && data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow create, read: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn()
        && request.auth.uid == userId
        && immutable(["role", "plan", "subscriptionStatus", "aiUsageCount"]);
      allow delete: if false;

      // Legacy compatibility: preserves the current user's own backup access.
      match /backup/{backupId} {
        allow read, create, update: if signedIn() && request.auth.uid == userId;
        allow delete: if false;
      }

      match /aiConsents/{memberId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && memberId.size() > 0
          && memberId.size() <= 160
          && request.resource.data.keys().hasOnly([
            "status", "policyVersion", "scopes", "grantedAt", "revokedAt", "updatedAt"
          ])
          && request.resource.data.status in ["granted", "revoked"]
          && request.resource.data.policyVersion == "2026-08-23"
          && request.resource.data.scopes is list
          && request.resource.data.scopes.size() <= 4
          && request.resource.data.scopes.hasOnly([
            "analyzeBody", "summarizeVoice", "recommendSequence", "generateReport"
          ])
          && request.resource.data.updatedAt is timestamp
          && (
            request.resource.data.status == "granted"
              ? request.resource.data.grantedAt is timestamp && request.resource.data.revokedAt == null
              : request.resource.data.revokedAt is timestamp && request.resource.data.scopes.size() == 0
          );
        allow delete: if false;
      }

      match /photoBackups/{photoId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && photoId.size() > 0
          && photoId.size() <= 160
          && request.resource.data.photoId == photoId
          && request.resource.data.memberId is string
          && request.resource.data.memberId.size() <= 160
          && request.resource.data.status in ["active", "deleted"]
          && request.resource.data.storagePath == "users/" + userId + "/photos/" + photoId + "/image.jpg"
          && request.resource.data.thumbnailPath == "users/" + userId + "/photos/" + photoId + "/thumb.jpg"
          && request.resource.data.imageBytes is int
          && request.resource.data.thumbnailBytes is int
          && request.resource.data.references is list
          && request.resource.data.references.size() <= 20;
        // Physical deletion is server-owned after the 30-day retention period.
        allow delete: if false;
      }
    }

    match /runtimeConfig/aiRecording {
      allow read: if signedIn();
      allow write: if false;
    }

    match /diagnostics/{userId}/reports/{reportId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          "schemaVersion", "createdAt", "app", "device", "logs", "logCount", "uid", "uploadedAt"
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt is string
        && request.resource.data.app is map
        && request.resource.data.device is map
        && request.resource.data.logs is list
        && request.resource.data.logs.size() <= 50
        && request.resource.data.logCount == request.resource.data.logs.size()
        && request.resource.data.uploadedAt is timestamp;
      allow update, delete: if false;
    }

    match /pilotMetrics/{userId}/attempts/{attemptId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          "schemaVersion", "uid", "date", "result", "flags", "confirmed", "latencyMs", "source", "updatedAt"
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.result in ["ok", "no_speech", "low_confidence", "failed"]
        && request.resource.data.flags is list
        && request.resource.data.flags.size() <= 3
        && request.resource.data.flags.hasOnly(["no_speech", "low_confidence", "tail_dropped"])
        && request.resource.data.confirmed is bool
        && request.resource.data.latencyMs is int
        && request.resource.data.latencyMs >= 0
        && request.resource.data.latencyMs <= 120000
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 40
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /organizations/{organizationId} {
      allow read: if isActiveMember(organizationId);
      allow create, delete: if false;
      allow update: if hasRole(organizationId, ["owner"])
        && immutable(["plan", "subscriptionStatus", "aiUsageCount"]);

      // Additive dual-write v1 paths. Existing top-level paths remain unchanged.
      match /clients/{clientId} {
        // See the locations block for why get and list are split. Here the
        // difference also narrows who may list: the get rule lets a member read
        // the one document linked to them, and a query cannot express "only my
        // own" without a filter to prove it. So listing the directory is for
        // staff, and a member still reads their own document one at a time.
        allow get: if isActiveMember(organizationId)
          && resource.data.organizationId == organizationId
          && (
            hasRole(organizationId, ["owner", "manager", "instructor", "staff"])
            || isOwnClientDocument(resource.data)
          );
        allow list: if hasRole(organizationId, ["owner", "manager", "instructor", "staff"]);
        // Validate what is present rather than requiring a fixed set. The
        // registration screen writes seven fields; the dual-write adapter
        // writes a wider legacy shape (clientId, membershipBalance,
        // legacySource, updatedAt...) and sometimes omits the rest. hasOnly
        // would reject that adapter, and hasAll would reject a create that
        // predates these fields. A floor that checks each field it actually
        // sees stops a malformed write from either writer without closing a
        // door the migration still needs.
        allow create: if request.resource.data.organizationId == organizationId
          && hasRole(organizationId, ["owner", "manager", "instructor", "staff"])
          && clientFieldsWellFormed();
        allow update: if resource.data.organizationId == organizationId
          && request.resource.data.organizationId == organizationId
          && hasRole(organizationId, ["owner", "manager", "instructor", "staff"]);
        allow delete: if false;
      }

      match /lessons/{lessonId} {
        // See the locations block for why get and list are split.
        allow get: if isActiveMember(organizationId)
          && resource.data.organizationId == organizationId;
        allow list: if isActiveMember(organizationId);
        allow create: if request.resource.data.organizationId == organizationId
          && hasRole(organizationId, ["owner", "manager", "instructor", "staff"]);
        allow update: if resource.data.organizationId == organizationId
          && request.resource.data.organizationId == organizationId
          && hasRole(organizationId, ["owner", "manager", "instructor", "staff"]);
        allow delete: if false;

        match /participants/{clientId} {
          // See the locations block for why get and list are split.
          allow get: if isActiveMember(organizationId)
            && resource.data.organizationId == organizationId;
          allow list: if isActiveMember(organizationId);
          allow create: if request.resource.data.organizationId == organizationId
            && request.resource.data.lessonId == lessonId
            && request.resource.data.clientId == clientId
            && hasRole(organizationId, ["owner", "manager", "instructor", "staff"]);
          allow update: if resource.data.organizationId == organizationId
            && request.resource.data.organizationId == organizationId
            && immutable(["lessonId", "clientId", "organizationId"])
            && hasRole(organizationId, ["owner", "manager", "instructor", "staff"]);
          allow delete: if false;
        }
      }

      // Event products change often, so they live as data instead of in code.
      // An existing product is never edited — it is archived and a new one added,
      // because passes already issued point at the terms it was sold under.
      // No unitPrice here: payroll rate comes from payCategory, and some of it
      // follows a per-instructor value.
      match /products/{productId} {
        allow read: if isActiveMember(organizationId);
        allow create: if request.resource.data.organizationId == organizationId
          && request.resource.data.keys().hasOnly([
            "organizationId", "name", "sessionType", "payCategory",
            "defaultSessions", "defaultPrice", "status", "createdAt", "createdBy"
          ])
          && request.resource.data.keys().hasAll([
            "organizationId", "name", "sessionType", "payCategory",
            "defaultSessions", "defaultPrice", "status", "createdAt", "createdBy"
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.sessionType in ["pt_1_1", "pt_2_1"]
          && request.resource.data.payCategory in payCategories()
          // A 2:1 lesson priced at the 1:1 rate differs by about ten thousand won
          // per session, and one bad product spreads that to every pass issued
          // from it. service and etc attach to either shape; letmein is 1:1 only.
          && (
            request.resource.data.sessionType == "pt_1_1"
              ? request.resource.data.payCategory in [
                "pt_1_1_new", "pt_1_1_repurchase_event", "pt_1_1_repurchase_normal",
                "service", "letmein", "etc"
              ]
              : request.resource.data.payCategory in [
                "pt_2_1_new", "pt_2_1_repurchase", "service", "etc"
              ]
          )
          && request.resource.data.defaultSessions is int
          && request.resource.data.defaultSessions > 0
          && request.resource.data.defaultPrice is int
          && request.resource.data.defaultPrice >= 0
          && request.resource.data.status in ["active", "archived"]
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && hasRole(organizationId, ["owner"]);
        // Only status moves, and it moves both ways. Everything else has to come
        // back unchanged — the set is closed, so this covers every field.
        allow update: if resource.data.organizationId == organizationId
          && request.resource.data.keys().hasOnly([
            "organizationId", "name", "sessionType", "payCategory",
            "defaultSessions", "defaultPrice", "status", "createdAt", "createdBy"
          ])
          && request.resource.data.keys().hasAll([
            "organizationId", "name", "sessionType", "payCategory",
            "defaultSessions", "defaultPrice", "status", "createdAt", "createdBy"
          ])
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.name == resource.data.name
          && request.resource.data.sessionType == resource.data.sessionType
          && request.resource.data.payCategory == resource.data.payCategory
          && request.resource.data.defaultSessions == resource.data.defaultSessions
          && request.resource.data.defaultPrice == resource.data.defaultPrice
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.status in ["active", "archived"]
          && hasRole(organizationId, ["owner"]);
        allow delete: if false;
      }

      // PT passes (20-session packs and the like). Distinct from top-level
      // memberships, which mean organization membership and gate access.
      match /passes/{passId} {
        allow read: if isActiveMember(organizationId);
        // The product fields are not settled yet, so require a floor rather than
        // closing the set with hasOnly.
        // A product carries the standard combination; what was actually sold is
        // recorded here, because the two are allowed to differ at issue time.
        allow create: if request.resource.data.organizationId == organizationId
          && request.resource.data.keys().hasAll([
            "organizationId", "clientId", "locationId", "productId",
            "totalSessions", "serviceSessions", "contractPrice",
            "paymentMethod", "purchaseRound", "status", "createdAt", "createdBy",
            // 발급 시점에 담당 강사가 정해진다. 없으면 차감한 회차가 누구의
            // 급여인지 알 수 없고, 교체 이력도 가리킬 대상이 없다.
            "instructorId"
          ])
          && request.resource.data.instructorId is string
          && request.resource.data.instructorId.size() > 0
          && request.resource.data.totalSessions is int
          && request.resource.data.totalSessions > 0
          && request.resource.data.serviceSessions is int
          && request.resource.data.serviceSessions >= 0
          && request.resource.data.contractPrice is int
          && request.resource.data.contractPrice >= 0
          && request.resource.data.purchaseRound is int
          && request.resource.data.purchaseRound >= 1
          // Keep in sync with PAYMENT_METHOD in src/data/schema/constants.js.
          && request.resource.data.paymentMethod in [
            "card", "cash", "transfer", "zeropay", "voucher"
          ]
          && request.resource.data.status is string
          && request.resource.data.createdAt == request.time
          && hasRole(organizationId, ["owner", "manager"]);
        // The owner's reach is unchanged. A manager may move one field and
        // nothing else: handovers happen while the owner is not at the centre,
        // and the transfer is safe because it rewrites no past entry — every
        // deducted session already carries the instructor it was taught by.
        allow update: if resource.data.organizationId == organizationId
          && request.resource.data.organizationId == organizationId
          && (
            hasRole(organizationId, ["owner"])
            || (
              hasRole(organizationId, ["manager"])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["instructorId"])
            )
          );
        allow delete: if false;

        // Append-only, and these numbers feed payroll. Nothing can be corrected
        // afterwards, so the write itself is the only place to reject a bad body.
        match /ledger/{entryId} {
          allow read: if isActiveMember(organizationId);
          allow create: if request.resource.data.organizationId == organizationId
            && request.resource.data.passId == passId
            && request.resource.data.keys().hasOnly([
              "organizationId", "passId", "locationId", "type", "delta",
              "category", "unitPrice", "lessonId", "instructorId",
              "fromInstructorId", "toInstructorId",
              "occurredAt", "createdAt", "createdBy"
            ])
            && request.resource.data.keys().hasAll([
              "organizationId", "passId", "locationId", "type", "delta",
              "occurredAt", "createdAt", "createdBy"
            ])
            && request.resource.data.type is string
            && request.resource.data.type in ["issue", "deduct", "transfer"]
            && request.resource.data.delta is int
            && request.resource.data.createdBy == request.auth.uid
            // createdAt says when it was recorded and the server stamps it, so a
            // client cannot backdate. occurredAt says when the lesson happened and
            // the client does send it — instructors enter a whole day at night —
            // so it is fenced to a window instead. Payroll totals by occurredAt.
            && request.resource.data.createdAt == request.time
            && request.resource.data.occurredAt is timestamp
            && request.resource.data.occurredAt <= request.time
            && request.resource.data.occurredAt > request.time - duration.value(7, "d")
            // A transfer moves no money, so category and unitPrice have no true
            // value to carry. Filling them to satisfy a required-field list would
            // put a fiction into the two fields payroll groups by; the entry says
            // nothing about them instead. issue and deduct still must carry both.
            && (
              request.resource.data.type == "transfer"
                ? (
                  request.resource.data.delta == 0
                  && request.resource.data.keys().hasAll(["fromInstructorId", "toInstructorId"])
                  && request.resource.data.fromInstructorId is string
                  && request.resource.data.toInstructorId is string
                  && request.resource.data.fromInstructorId != request.resource.data.toInstructorId
                  && !("category" in request.resource.data)
                  && !("unitPrice" in request.resource.data)
                  && !("lessonId" in request.resource.data)
                  // 담당 교체는 운영하는 사람의 판단이다. 강사가 자기 앞으로
                  // 회원권을 옮길 수 있으면 급여가 스스로 움직인다.
                  && hasRole(organizationId, ["owner", "manager"])
                )
                : (
                  request.resource.data.keys().hasAll(["category", "unitPrice", "instructorId"])
                  && request.resource.data.category in payCategories()
                  && request.resource.data.unitPrice is int
                  && request.resource.data.unitPrice >= 0
                  && request.resource.data.delta != 0
                  && (
                    request.resource.data.type == "issue"
                      ? request.resource.data.delta > 0
                      : request.resource.data.delta < 0 && "lessonId" in request.resource.data
                  )
                  && hasRole(organizationId, ["owner", "manager", "instructor"])
                )
            );
          allow update, delete: if false;
        }
      }

      match /lessonNotes/{noteId} {
        // See the locations block for why get and list are split. As with
        // clients, a query cannot prove "only the notes about me", so listing
        // is for the roles that teach and run the centre; a member still reads
        // their own note one document at a time.
        allow get: if isActiveMember(organizationId)
          && resource.data.organizationId == organizationId
          && (
            hasRole(organizationId, ["owner", "manager", "instructor"])
            || resource.data.userId == request.auth.uid
          );
        allow list: if hasRole(organizationId, ["owner", "manager", "instructor"]);
        allow create: if request.resource.data.organizationId == organizationId
          && hasRole(organizationId, ["owner", "manager", "instructor"]);
        allow update: if resource.data.organizationId == organizationId
          && request.resource.data.organizationId == organizationId
          && request.auth.uid == resource.data.createdBy
          && immutable(["clientId", "lessonId", "createdBy", "createdAt"]);
        allow delete: if false;
      }

      match /locations/{locationId} {
        // get and list are split on purpose. A list rule is evaluated against
        // what the query guarantees, not against the documents it returns, so a
        // `resource.data` test the query does not constrain can never be
        // satisfied — the whole query is refused with "Property organizationId
        // is undefined on object", which reaches the screen as an empty picker.
        // The path already scopes these documents to one organization, so the
        // membership check alone is what a list can honestly enforce.
        allow get: if isActiveMember(organizationId)
          && resource.data.organizationId == organizationId;
        allow list: if isActiveMember(organizationId);
        allow create: if request.resource.data.organizationId == organizationId
          && hasRole(organizationId, ["owner", "manager"]);
        allow update: if resource.data.organizationId == organizationId
          && request.resource.data.organizationId == organizationId
          && hasRole(organizationId, ["owner", "manager"]);
        allow delete: if false;
      }
    }

    // The rate history hangs off a membership, whose path does not carry the
    // organization. Reading the parent gives the rule an organization without
    // touching resource.data, so the same condition works for get and list —
    // see the list note near the top of this file.
    function membershipOrganizationId(membershipDocumentId) {
      return get(/databases/$(database)/documents/memberships/$(membershipDocumentId)).data.organizationId;
    }

    match /memberships/{membershipDocumentId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || hasRole(resource.data.organizationId, ["owner", "manager"])
      );
      allow create, delete: if false;
      // One field, one role. The full-room rate decides what a repurchase
      // lesson pays its instructor, so an instructor must not set their own;
      // and nothing else about a membership — role, status, organization —
      // may travel through this door.
      allow update: if hasRole(resource.data.organizationId, ["owner"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["fullRoomRate"])
        && request.resource.data.fullRoomRate is int
        && request.resource.data.fullRoomRate >= 0;

      // Append-only. The rate changes when an instructor passes a grading, and
      // "since when was it this much" has to stay answerable. This is a record,
      // never a payroll input — payroll reads the unitPrice frozen into each
      // ledger entry, so raising a rate never moves a settled month.
      match /rateHistory/{entryId} {
        allow read: if hasRole(membershipOrganizationId(membershipDocumentId), ["owner"]);
        allow create: if hasRole(membershipOrganizationId(membershipDocumentId), ["owner"])
          && request.resource.data.organizationId == membershipOrganizationId(membershipDocumentId)
          && request.resource.data.keys().hasOnly([
            "organizationId", "userId", "previousRate", "newRate",
            "effectiveFrom", "changedBy", "createdAt"
          ])
          && request.resource.data.keys().hasAll([
            "organizationId", "userId", "newRate",
            "effectiveFrom", "changedBy", "createdAt"
          ])
          && request.resource.data.userId is string
          && request.resource.data.userId.size() > 0
          && request.resource.data.newRate is int
          && request.resource.data.newRate >= 0
          // null means there was no rate before this one.
          && (
            request.resource.data.previousRate == null
            || (request.resource.data.previousRate is int && request.resource.data.previousRate >= 0)
          )
          && request.resource.data.previousRate != request.resource.data.newRate
          && request.resource.data.changedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          // createdAt is when it was recorded; effectiveFrom is when the raise
          // actually took effect, which can be a few days earlier because a
          // grading result arrives before anyone opens the app.
          && request.resource.data.effectiveFrom is timestamp
          && request.resource.data.effectiveFrom <= request.time
          && request.resource.data.effectiveFrom > request.time - duration.value(7, "d");
        allow update, delete: if false;
      }
    }

    match /assessments/{assessmentId} {
      allow read: if isActiveMember(resource.data.organizationId)
        && (
          hasRole(resource.data.organizationId, ["owner", "manager", "instructor"])
          || resource.data.userId == request.auth.uid
        );
      allow create: if hasRole(request.resource.data.organizationId, ["owner", "manager", "instructor"]);
      allow update: if sameOrganization()
        && immutable(["clientId", "createdBy", "createdAt"])
        && hasRole(resource.data.organizationId, ["owner", "manager", "instructor"]);
      allow delete: if false;
    }

    match /assessmentMedia/{mediaId} {
      allow read: if isActiveMember(resource.data.organizationId)
        && (
          hasRole(resource.data.organizationId, ["owner", "manager", "instructor"])
          || resource.data.userId == request.auth.uid
        );
      allow create, update, delete: if false;
    }

    match /inbodyMeasurements/{measurementId} {
      allow read: if isActiveMember(resource.data.organizationId)
        && (
          hasRole(resource.data.organizationId, ["owner", "manager", "instructor"])
          || resource.data.userId == request.auth.uid
        );
      allow create: if hasRole(request.resource.data.organizationId, ["owner", "manager", "instructor"]);
      allow update, delete: if false;
    }

    match /exercisePrograms/{programId} {
      allow read: if isActiveMember(resource.data.organizationId)
        && (
          hasRole(resource.data.organizationId, ["owner", "manager", "instructor"])
          || resource.data.userId == request.auth.uid
        );
      allow create: if hasRole(request.resource.data.organizationId, ["owner", "manager", "instructor"]);
      allow update: if sameOrganization()
        && immutable(["sourceRecommendationId", "createdBy", "createdAt"])
        && hasRole(resource.data.organizationId, ["owner", "manager", "instructor"]);
      allow delete: if false;
    }

    match /exerciseHistory/{historyId} {
      allow read: if isActiveMember(resource.data.organizationId)
        && (
          hasRole(resource.data.organizationId, ["owner", "manager", "instructor"])
          || resource.data.userId == request.auth.uid
        );
      allow create: if hasRole(request.resource.data.organizationId, ["owner", "manager", "instructor"]);
      allow update, delete: if false;
    }

    match /aiRecommendations/{recommendationId} {
      allow read: if isActiveMember(resource.data.organizationId)
        && (
          hasRole(resource.data.organizationId, ["owner", "manager", "instructor"])
          || resource.data.userId == request.auth.uid
        );
      allow create, update, delete: if false;
    }

    match /aiFeedback/{feedbackId} {
      allow read: if hasRole(resource.data.organizationId, ["owner", "manager", "instructor"]);
      allow create: if hasRole(request.resource.data.organizationId, ["owner", "manager", "instructor"])
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /outcomes/{outcomeId} {
      allow read: if hasRole(resource.data.organizationId, ["owner", "manager", "instructor"]);
      allow create, update, delete: if false;
    }

    match /memberGoals/{goalId} {
      allow read: if isActiveMember(resource.data.organizationId)
        && (
          hasRole(resource.data.organizationId, ["owner", "manager", "instructor"])
          || resource.data.userId == request.auth.uid
        );
      allow create: if hasRole(request.resource.data.organizationId, ["owner", "manager", "instructor"]);
      allow update, delete: if false;
    }

    match /memberProgress/{progressId} {
      allow read: if isActiveMember(resource.data.organizationId)
        && (
          hasRole(resource.data.organizationId, ["owner", "manager", "instructor"])
          || resource.data.userId == request.auth.uid
        );
      allow create, update, delete: if false;
    }

    match /events/{eventId} {
      allow read: if isActiveMember(resource.data.organizationId);
      allow create, update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if hasRole(resource.data.organizationId, ["owner", "manager"]);
      allow create, update, delete: if false;
    }

    match /dailyStats/{statId} {
      allow read: if hasRole(resource.data.organizationId, ["owner", "manager", "instructor", "staff"]);
      allow create, update, delete: if false;
    }

    match /teacherPatterns/{patternId} {
      allow read: if hasRole(resource.data.organizationId, ["owner", "manager", "instructor"]);
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
