{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "src/ai/**/*.js",
    "src/data/**/*.js",
    "src/features/auth/**/*.js",
    "src/features/account/**/*.js",
    "tools/**/*.js",
    "tests/schema/**/*.js",
    "tests/migration/**/*.js",
    "tests/validation/**/*.js",
    "tests/dual-write/**/*.js",
    "tests/ai/**/*.js",
    "tests/app-review/**/*.js"
  ]
}
