{
  "name": "pilateacher",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p jsconfig.foundation.json",
    "lint": "eslint src/data tools tests",
    "test:foundation": "node --test tests/schema/*.test.js tests/migration/*.test.js tests/validation/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project pilateacher-dev --config firebase.foundation.json \"node --test tests/rules/firestore.rules.test.js\"",
    "backfill:dry-run": "node tools/migration/cli.js --fixture tests/fixtures/legacy-backup.json",
    "validate:fixture": "node tools/validation/cli.js --legacy tests/fixtures/legacy-backup.json --new tests/fixtures/new-structure.json --format markdown"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "firebase": "^12.16.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.396.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.8.0",
    "firebase-tools": "^15.25.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^7.0.2",
    "vite": "^5.3.4"
  }
}
