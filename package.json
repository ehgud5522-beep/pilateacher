{
  "name": "pilateacher",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node tools/patch-camera-preview-ios-no-location.mjs && node tools/patch-camera-preview-ios-session-safety.mjs && node tools/patch-camera-preview-ios-h6.mjs && node tools/patch-firebase-auth-ios-first-login-profile.mjs && node tools/patch-speech-recognition-capacitor8.mjs && node tools/patch-audio-recorder-edge.mjs && node tools/patch-audio-recorder-h4.mjs && node tools/patch-audio-recorder-h5.mjs && node tools/patch-audio-recorder-h6.mjs",
    "dev": "vite",
    "prebuild": "npm run typecheck && npm run lint:runtime && npm run test:screen-smoke",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p jsconfig.foundation.json",
    "lint": "eslint src/ai src/data src/features/auth src/features/account src/features/voice tools tests",
    "lint:runtime": "eslint src",
    "test:foundation": "node --test tests/schema/*.test.js tests/migration/*.test.js tests/validation/*.test.js",
    "test:dual-write": "node --test tests/dual-write/*.test.js",
    "test:app-review": "node --test tests/app-review/*.test.js",
    "test:android-release": "node --test tests/android/release-guard.test.js",
    "test:voice": "node --test tests/voice/*.test.js",
    "test:screen-smoke": "node --test tests/ui/screen-render-smoke.test.js",
    "android:release:guard": "node tools/android/release-guard.mjs --stage preflight",
    "android:release:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/android/build-release.ps1",
    "android:release:verify": "node tools/android/release-guard.mjs --stage artifact --aab",
    "test:rules": "firebase emulators:exec --only firestore,storage --project pilateacher-dev --config firebase.foundation.json \"node --test tests/rules/firestore.rules.test.js\"",
    "backfill:dry-run": "node tools/migration/cli.js --fixture tests/fixtures/legacy-backup.json",
    "validate:fixture": "node tools/validation/cli.js --legacy tests/fixtures/legacy-backup.json --new tests/fixtures/new-structure.json --format markdown"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/motion": "8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capgo/camera-preview": "8.11.2",
    "@capgo/capacitor-audio-recorder": "^8.2.7",
    "firebase": "^12.16.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.396.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.8.0",
    "firebase-tools": "^15.25.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^7.0.2",
    "vite": "^5.3.4"
  }
}
