rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Two current server reads, never claims cached in the user's old login token.
    function assigned(scope) {
      let membership = firestore.get(/databases/(default)/documents/memberships/$(scope.organizationId + "_" + request.auth.uid)).data;
      let client = firestore.get(/databases/(default)/documents/organizations/$(scope.organizationId)/clients/$(scope.clientId)).data;
      return scope.get("moving", "false") != "true" && membership.status == "active"
        && membership.role in ["owner", "area_manager", "manager", "instructor", "staff"]
        && client.get("photoAccessRevoked", {}).get(request.auth.uid, false) != true
        && (membership.role in ["owner", "area_manager"] || request.auth.uid in client.get("instructorIds", []));
    }
    match /users/{userId}/photos/{photoId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId && assigned(resource.metadata);
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && assigned(request.resource.metadata)
        && (resource == null || assigned(resource.metadata))
        && (resource == null || (request.resource.metadata.organizationId == resource.metadata.organizationId
          && request.resource.metadata.clientId == resource.metadata.clientId))
        && photoId.size() > 0
        && photoId.size() <= 160
        && ((fileName in ["image.jpg", "thumb.jpg"] && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType == "image/jpeg")
          || (fileName == "original.bin" && resource == null && request.resource.size < 50 * 1024 * 1024 && request.resource.contentType == "application/octet-stream"));
      allow delete: if false;
    }

    /* 옮기기 전 스냅샷 (2026-10-31, 서버 기준 동기화 0단계).
       기기 데이터를 서버로 옮기기 직전에 한 벌 남기는 자리다. 무엇이 꼬여도
       이것으로 돌아가므로 **한 번 쓰면 고치지도 지우지도 못한다** -- update 가
       열려 있으면 같은 이름으로 다시 올린 것이 원래 것을 덮는다.
       사진 원본은 담지 않는다(대표 결정): 앱이 사진 목록만 싣고, 여기서는
       JSON 파일 하나 · 20MB 까지만 받는다. 본인만 읽는다. */
    match /users/{userId}/snapshots/{snapshotId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && snapshotId.matches("^[A-Za-z0-9_-]{1,120}$")
        && fileName == "db.json"
        && resource == null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == "application/json";
      allow update, delete: if false;
    }
  }
}
